<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>MorphFaceEditor.LegendaryExplorer</AssemblyName>
    <RootNamespace>MorphFaceEditor.LegendaryExplorer</RootNamespace>
    <LecDirectory>$(MSBuildThisFileDirectory)..\..\lib\LegendaryExplorerCore</LecDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MorphFaceEditor.Core\MorphFaceEditor.Core.csproj" />
    <InternalsVisibleTo Include="MorphFaceEditor.Tests" />
    <InternalsVisibleTo Include="MorphFaceEditor.DataCompiler" />
    <InternalsVisibleTo Include="MorphFaceEditor.QA" />
    <Reference Include="LegendaryExplorerCore">
      <HintPath>$(LecDirectory)\LegendaryExplorerCore.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(LecDirectory)\LegendaryExplorerCore.pdb" Condition="'$(Configuration)' == 'Debug'"
          Link="LegendaryExplorerCore.pdb"
          CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(LecDirectory)\CompressionWrappers.dll"
             Link="CompressionWrappers.dll"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(LecDirectory)\TexConverter.dll"
             Link="TexConverter.dll"
             CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\CrossGameAssetReconciliation.json"
                      LogicalName="MorphFaceEditor.CrossGameAssetReconciliation.json" />
    <EmbeddedResource Include="Assets\MaterialDependencyOracle.json"
                      LogicalName="MorphFaceEditor.MaterialDependencyOracle.json" />
    <EmbeddedResource Include="Assets\StockMaterialMetadata.json"
                      LogicalName="MorphFaceEditor.StockMaterialMetadata.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" />
    <PackageReference Include="BCnEncoder.Net.ImageSharp" />
    <PackageReference Include="CommunityToolkit.Diagnostics" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="SharpDX.D3DCompiler" />
    <PackageReference Include="SharpGLTF.Toolkit" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <_PinnedLecFile Include="$(LecDirectory)\LegendaryExplorerCore.dll"
                    ExpectedHash="5BEFC63667C5B14E1605E8DBB6183ED9C784FCBC9F15B0F2F1B64E97ED6089B0" />
    <_PinnedLecFile Include="$(LecDirectory)\CompressionWrappers.dll"
                    ExpectedHash="D0417B39CE27BBA575EEC6FB529DFB0614F14750636F0242C0AA7B00CBA7B745" />
    <_PinnedLecFile Include="$(LecDirectory)\TexConverter.dll"
                    ExpectedHash="CE8D9728246585F0389F50699B3BA37F3D3FECE722E4770B346583CAECBC5607" />
    <_PinnedLecFile Include="$(LecDirectory)\LegendaryExplorerCore.pdb" Condition="'$(Configuration)' == 'Debug'"
                    ExpectedHash="67A202181CFD9EA01DE317D932BF0601DEE58BA141D184B8BD341E7DF4F3B0F6" />
  </ItemGroup>
  <Target Name="VerifyLegendaryExplorerCorePin" BeforeTargets="ResolveReferences">
    <GetFileHash Files="@(_PinnedLecFile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_LecCoreHash" />
    </GetFileHash>
    <Error Condition="'%(_LecCoreHash.FileHash)' != '%(_LecCoreHash.ExpectedHash)'"
           Text="%(_LecCoreHash.Filename)%(_LecCoreHash.Extension) does not match pinned commit 804db0b9a37d6184e8a06e4fecb30270d2fb48c8." />
  </Target>
</Project>
