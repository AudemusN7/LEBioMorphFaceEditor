<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MorphFaceEditor.Rendering</AssemblyName>
    <RootNamespace>MorphFaceEditor.Rendering</RootNamespace>
    <HeadPreviewShaderBundle>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\HeadPreviewShaders.zip</HeadPreviewShaderBundle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MorphFaceEditor.Core\MorphFaceEditor.Core.csproj" />
    <ProjectReference Include="..\..\tools\MorphFaceEditor.ShaderCompiler\MorphFaceEditor.ShaderCompiler.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="ShaderCompilerAssembly" />
    <PackageReference Include="SharpDX" />
    <PackageReference Include="SharpDX.D3DCompiler" />
    <PackageReference Include="SharpDX.Direct3D11" />
    <PackageReference Include="SharpDX.DXGI" />
    <PackageReference Include="SharpDX.Mathematics" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(HeadPreviewShaderBundle)"
                      LogicalName="MorphFaceEditor.Rendering.Shaders.HeadPreviewShaders.zip" />
  </ItemGroup>
  <Target Name="CompileHeadPreviewShaders" BeforeTargets="PrepareResources"
          Inputs="Shaders\HeadPreview.hlsl;@(ShaderCompilerAssembly)"
          Outputs="$(HeadPreviewShaderBundle)" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;@(ShaderCompilerAssembly)&quot; &quot;$(MSBuildProjectDirectory)\Shaders\HeadPreview.hlsl&quot; &quot;$(MSBuildProjectDirectory)\$(HeadPreviewShaderBundle)&quot;" />
    <ItemGroup>
      <FileWrites Include="$(HeadPreviewShaderBundle)" />
    </ItemGroup>
  </Target>
</Project>
