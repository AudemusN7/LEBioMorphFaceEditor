<UserControl x:Class="MorphFaceEditor.Controls.BoneTransformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MorphFaceEditor.Controls"
             Focusable="False"
             HorizontalAlignment="Stretch">
    <Grid SizeChanged="OnControlSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <controls:SquareDecorator HorizontalAlignment="Stretch">
            <Border x:Name="Pad"
                    Background="{DynamicResource BonePadBackground}"
                    BorderBrush="{DynamicResource BonePadBorder}"
                    BorderThickness="1"
                    Cursor="Cross"
                    MouseLeftButtonDown="OnPadMouseLeftButtonDown"
                    MouseMove="OnPadMouseMove"
                    MouseLeftButtonUp="OnPadMouseLeftButtonUp"
                    LostMouseCapture="OnPadLostMouseCapture"
                    PreviewMouseWheel="OnPadMouseWheel">
                <Grid Margin="1" ClipToBounds="True">
                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{DynamicResource BoneGridLine}" />
                    <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource BoneGridLine}" />
                    <TextBlock Text="Up (Z+)" Foreground="{DynamicResource MutedText}" FontSize="9"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" />
                    <TextBlock Text="Down (Z-)" Foreground="{DynamicResource MutedText}" FontSize="9"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                    <TextBlock Text="Left (Y-)" Foreground="{DynamicResource MutedText}" FontSize="9"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" />
                    <TextBlock Text="Right (Y+)" Foreground="{DynamicResource MutedText}" FontSize="9"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Canvas x:Name="PuckCanvas" IsHitTestVisible="False">
                        <Ellipse x:Name="Puck"
                                 Width="20" Height="20"
                                 Fill="{DynamicResource Accent}"
                                 Stroke="{DynamicResource PuckOutline}"
                                 StrokeThickness="2" />
                    </Canvas>
                </Grid>
            </Border>
        </controls:SquareDecorator>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Depth (X +/-)" Foreground="{DynamicResource SecondaryText}" FontSize="10"
                       Margin="0,0,8,0" VerticalAlignment="Center" />
            <Grid x:Name="DepthTrack" Grid.Column="1" Height="18"
                  Cursor="SizeWE"
                  MouseLeftButtonDown="OnDepthMouseLeftButtonDown"
                  MouseMove="OnDepthMouseMove"
                  MouseLeftButtonUp="OnDepthMouseLeftButtonUp"
                  LostMouseCapture="OnDepthLostMouseCapture">
                <Rectangle Height="2" Fill="{DynamicResource BoneRail}" VerticalAlignment="Center" />
                <Rectangle Width="1" Height="10" Fill="{DynamicResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Canvas x:Name="DepthCanvas" IsHitTestVisible="False">
                    <Rectangle x:Name="DepthThumb" Canvas.Top="3" Width="3" Height="12" Fill="{DynamicResource Accent}" />
                </Canvas>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
