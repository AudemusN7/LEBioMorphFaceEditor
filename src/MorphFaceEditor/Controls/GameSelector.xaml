<ListBox x:Class="MorphFaceEditor.Controls.GameSelector"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:domain="clr-namespace:MorphFaceEditor.Core.Domain;assembly=MorphFaceEditor.Core"
         SelectionMode="Single" HorizontalAlignment="Left"
         KeyboardNavigation.TabNavigation="Once">
    <ListBox.Template>
        <ControlTemplate TargetType="ListBox">
            <ItemsPresenter />
        </ControlTemplate>
    </ListBox.Template>
    <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
            <Setter Property="Width" Value="66" />
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="0,0,26,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="ToolTip" Value="{Binding}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Opacity="0.65" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource PrimaryText}" BorderThickness="1"
                                    CornerRadius="8" Margin="-3" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="1" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:MorphFaceGame.LE1}">
                    <Setter Property="Background">
                        <Setter.Value><ImageBrush ImageSource="pack://application:,,,/MorphFaceEditor;component/Assets/GameIcons/LE1.png" /></Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:MorphFaceGame.LE2}">
                    <Setter Property="Background">
                        <Setter.Value><ImageBrush ImageSource="pack://application:,,,/MorphFaceEditor;component/Assets/GameIcons/LE2.png" /></Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static domain:MorphFaceGame.LE3}">
                    <Setter Property="Background">
                        <Setter.Value><ImageBrush ImageSource="pack://application:,,,/MorphFaceEditor;component/Assets/GameIcons/LE3.png" /></Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ListBox.ItemContainerStyle>
</ListBox>
