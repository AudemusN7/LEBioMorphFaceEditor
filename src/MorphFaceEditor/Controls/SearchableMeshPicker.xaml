<UserControl x:Class="MorphFaceEditor.Controls.SearchableMeshPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="PickerButton"
                      MinHeight="26"
                      Focusable="True"
                      HorizontalContentAlignment="Stretch"
                      PreviewMouseWheel="OnPickerPreviewMouseWheel"
                      PreviewKeyDown="OnPickerPreviewKeyDown"
                      ToolTip="Choose a mesh attachment">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{StaticResource RaisedBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBackground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <Grid Margin="5,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Selected.DisplayName}"
                           Foreground="{StaticResource PrimaryText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="▼" Foreground="{StaticResource MutedText}"
                           FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </ToggleButton>

        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=PickerButton}"
               Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=PickerButton, Mode=TwoWay}"
               AllowsTransparency="True"
               StaysOpen="True"
               Opened="OnPopupOpened"
               Closed="OnPopupClosed">
            <Border Width="{Binding ActualWidth, ElementName=Root}"
                    MinWidth="360"
                    Padding="6"
                    PreviewKeyDown="OnPopupPreviewKeyDown"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnSearchTextChanged"
                             ToolTip="Search by mesh name, path, or source package"
                             Margin="0,0,0,6" />
                    <ListBox Grid.Row="1"
                             x:Name="CandidateList"
                             ItemsSource="{Binding Candidates}"
                             MouseLeave="OnCandidateListMouseLeave"
                             Height="390"
                             MinHeight="80"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MouseEnter="OnCandidateMouseEnter"
                                      PreviewMouseLeftButtonUp="OnCandidateMouseLeftButtonUp">
                                    <StackPanel Margin="4,3">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SourceDescription}" Foreground="{StaticResource MutedText}"
                                                   FontSize="9" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Thumb Grid.Row="2" Height="12" Margin="0,5,0,0"
                           Cursor="SizeNS" DragDelta="OnResizeDragDelta"
                           ToolTip="Drag to resize mesh list"
                           AutomationProperties.Name="Resize mesh list">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent">
                                    <Border Width="42" Height="3" CornerRadius="2"
                                            Background="{StaticResource MutedText}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
