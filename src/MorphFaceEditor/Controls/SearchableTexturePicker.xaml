<UserControl x:Class="MorphFaceEditor.Controls.SearchableTexturePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="PickerButton"
                      MinHeight="26"
                      Focusable="True"
                      HorizontalContentAlignment="Stretch"
                      PreviewMouseWheel="OnPickerPreviewMouseWheel"
                      PreviewKeyDown="OnPickerPreviewKeyDown"
                      ToolTip="Choose a texture">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{StaticResource RaisedBackground}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBackground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <Grid Margin="5,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedTexture.DisplayName}"
                           Foreground="{StaticResource PrimaryText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="▼" Foreground="{StaticResource MutedText}"
                           FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </ToggleButton>

        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=PickerButton}"
               Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=PickerButton, Mode=TwoWay}"
               AllowsTransparency="True"
               StaysOpen="True"
               Opened="OnPopupOpened"
               Closed="OnPopupClosed">
            <Border Width="{Binding ActualWidth, ElementName=Root}"
                    MinWidth="360"
                    MaxHeight="440"
                    Padding="6"
                    PreviewKeyDown="OnPopupPreviewKeyDown"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by texture name, path, source package, or origin"
                             Margin="0,0,0,6" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Candidates}"
                             SelectedItem="{Binding SelectedTexture}"
                             SelectionChanged="OnSelectionChanged"
                             MaxHeight="390"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MouseEnter="OnCandidateMouseEnter">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" Background="#0B0E12"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding Asset.Thumbnail}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SourceDescription}" Foreground="{StaticResource MutedText}"
                                                   FontSize="9" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid.ToolTip>
                                        <Border Background="{StaticResource PanelBackground}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" Padding="8">
                                            <StackPanel>
                                                <Image Source="{Binding Asset.Thumbnail}" Width="192" Height="192"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource SecondaryText}"
                                                           FontSize="10" Margin="0,6,0,0" MaxWidth="260" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SourceDescription}" Foreground="{StaticResource MutedText}"
                                                           FontSize="10" Margin="0,3,0,0" MaxWidth="260" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Asset.ThumbnailError}" Foreground="#FFFF8C8C"
                                                           FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid.ToolTip>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
