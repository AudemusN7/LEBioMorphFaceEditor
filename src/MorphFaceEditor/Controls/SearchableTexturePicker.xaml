<UserControl x:Class="MorphFaceEditor.Controls.SearchableTexturePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <ToggleButton x:Name="PickerButton"
                      MinHeight="26"
                      HorizontalContentAlignment="Stretch"
                      ToolTip="Choose a texture">
            <Grid Margin="5,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedTexture.DisplayName}"
                           Foreground="{StaticResource PrimaryText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="▼" Foreground="{StaticResource MutedText}"
                           FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </ToggleButton>

        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=PickerButton}"
               Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=PickerButton, Mode=TwoWay}"
               AllowsTransparency="True"
               StaysOpen="False"
               Opened="OnPopupOpened"
               Closed="OnPopupClosed">
            <Border Width="{Binding ActualWidth, ElementName=Root}"
                    MinWidth="360"
                    MaxHeight="440"
                    Padding="6"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by texture name, path, source package, or origin"
                             Margin="0,0,0,6" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Candidates}"
                             SelectedItem="{Binding SelectedTexture}"
                             SelectionChanged="OnSelectionChanged"
                             MaxHeight="390"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MouseEnter="OnCandidateMouseEnter">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" Background="#0B0E12"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding Asset.Thumbnail}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SourceDescription}" Foreground="{StaticResource MutedText}"
                                                   FontSize="9" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
