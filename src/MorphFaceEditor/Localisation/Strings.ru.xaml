    <!--localiser: {"Key":"loc_FileSave_UnsavedTitle","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"AFDD5B8AE161D7E17C477662D6117FD25B146CB5F961320FA32AD9AE462D2F91"}--><system:String x:Key="loc_FileSave_UnsavedTitle" xml:space="preserve">Несохранённые изменения файла</system:String>
