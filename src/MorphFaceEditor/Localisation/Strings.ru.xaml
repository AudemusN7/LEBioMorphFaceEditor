    <!--localiser: {"Key":"loc_Pcsav_ConfirmDelete","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"FDBA34D460C2EF70BA74A3B7629CCA444848C2BB9B186AFADD06805B80C21A71"}--><system:String x:Key="loc_Pcsav_ConfirmDelete" xml:space="preserve">Удалить пользовательский headmorph персонажа {0} из сохранения карьеры? Файл будет немедленно сохранён, а рабочая область закрыта. Игра будет использовать стандартную голову Шепарда.</system:String>
    <!--localiser: {"Key":"loc_Pcsav_Deleted","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"1BC4880626D1A40C0F4477E8767AB80482D41CABFDBF4A48ACA4FEB53985DFAD"}--><system:String x:Key="loc_Pcsav_Deleted" xml:space="preserve">Headmorph удалён, файл {0} сохранён.</system:String>
