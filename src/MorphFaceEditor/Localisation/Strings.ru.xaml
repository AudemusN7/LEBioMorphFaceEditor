    <!--localiser: {"Key":"loc_Pcsav_InvalidFile","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"A93F9C998F580DBC0C2D53BD07C5AE8A15579BA3A8AF5F7AB870DA2D2EEC89E6"}--><system:String x:Key="loc_Pcsav_InvalidFile" xml:space="preserve">Сохранение карьеры повреждено или его данные не удалось безопасно прочитать.</system:String>
