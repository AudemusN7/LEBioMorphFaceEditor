    <!--localiser: {"Key":"loc_Shell_Error_CcScalp_WrongMaster","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"8CBD6D91A239EEB372FCFE77023CC8C75314752995DEA4CFDF35F0F8CA9E20BC"}--><system:String x:Key="loc_Shell_Error_CcScalp_WrongMaster" xml:space="preserve">Выбранный материал кожи головы &apos;{0}&apos; использует &apos;{1}&apos; вместо поддерживаемого основного материала кожи головы CC.</system:String>
