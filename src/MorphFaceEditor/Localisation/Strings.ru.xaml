    <!-- Mesh and texture database guidance -->
    <!--localiser: {"Key":"loc_Shell_Warning_CustomMaterialDatabaseUnavailable","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"3FB8CF0E2CE14E069B2A037DB736F58361D7AA0466624CBD3DAEFA793B8D04D3"}--><system:String x:Key="loc_Shell_Warning_CustomMaterialDatabaseUnavailable" xml:space="preserve">Без базы моделей и текстур для пользовательских моделей доступен лишь ограниченный набор материалов людей, а материалы инопланетян недоступны. Создайте базу активной игры в разделе «Базы моделей и текстур», затем импортируйте модель повторно.</system:String>
    <!--localiser: {"Key":"loc_Shell_ImportWarnings_DatabaseGuidance","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"670FA8E819D2F9288E5403B1F09D0E8BBE9E4B5DD0E5C6621893C9A01F677C1E"}--><system:String x:Key="loc_Shell_ImportWarnings_DatabaseGuidance" xml:space="preserve">Создание или обновление базы активной игры в разделе «Базы моделей и текстур» может помочь найти недостающие ресурсы, в том числе ресурсы установленных модов. Повторите импорт после сканирования. Ресурсы модов, которые по-прежнему не найдены, может потребоваться добавить в пользовательскую базу.</system:String>
    <!-- RON interchange -->
    <!--localiser: {"Key":"loc_Shell_Error_RonProfileUnsupported","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"DB7885ED27B76E4CF4F7FD6E58952055E121909811971E0AB43C2E50B7DDEA07"}--><system:String x:Key="loc_Shell_Error_RonProfileUnsupported" xml:space="preserve">Это лицо нельзя экспортировать как полный RON морфа, поскольку MFE не поддерживает импорт RON для его профиля головы. Настройки материалов по-прежнему можно экспортировать отдельно.</system:String>
    <!--localiser: {"Key":"loc_Shell_Error_MaterialDefaultFaceUnavailable","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"5B778DEBD80CB8ED8537289B45954CEFD70982D695E6F2F0DEBC4A83D100B17B"}--><system:String x:Key="loc_Shell_Error_MaterialDefaultFaceUnavailable" xml:space="preserve">Для {0} в {1} нет установленного лица по умолчанию.</system:String>
    <!--localiser: {"Key":"loc_FileSave_MultipleImports","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"73B23C61D3C3C91EA9AC37DC1EF0717AEF79CD2B57BF4E02F35C06B793148932"}--><system:String x:Key="loc_FileSave_MultipleImports" xml:space="preserve">Это временное рабочее пространство содержит несколько импортированных морфов. Чтобы сохранить морф, щёлкните по нему правой кнопкой мыши в левой панели и выберите вариант экспорта.</system:String>
    <!--localiser: {"Key":"loc_FileSave_MeshChoice","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"7E691A2F8BCA1476B071061B87A31EE72CB8407448F5A8A1E7687FBB47620356"}--><system:String x:Key="loc_FileSave_MeshChoice" xml:space="preserve">Выберите способ сохранения изменений меша.</system:String>
    <!--localiser: {"Key":"loc_FileSave_OtherFace","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"5D9FDDD337F8BDF6F7AC9E2CD1AD64C09C90054DAC1DEF1D6B9B0BD6967DA223"}--><system:String x:Key="loc_FileSave_OtherFace" xml:space="preserve">Чтобы сохранить эти изменения, щёлкните правой кнопкой мыши по отредактированному морфу в левой панели и выберите вариант экспорта.</system:String>
    <!--localiser: {"Key":"loc_FileSave_SourceChanged","ReviewedHash":null,"DoNotTranslate":false,"Note":"","SourceHash":"33AFD6162B2DF22A201CBB795B67E90080A113570DE6FAE0EA4A9A1D0E2F8956"}--><system:String x:Key="loc_FileSave_SourceChanged" xml:space="preserve">Исходный файл был изменён после открытия. Откройте его заново или экспортируйте изменения в другой файл.</system:String>
