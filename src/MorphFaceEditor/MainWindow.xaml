<Window x:Class="MorphFaceEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MorphFaceEditor.Controls"
        xmlns:infrastructure="clr-namespace:MorphFaceEditor.Infrastructure"
        infrastructure:WindowTitle.Caption="{DynamicResource loc_View_MainWindow_BioMorphFaceEditor}"
        Width="1540"
        Height="820"
        MinWidth="1100"
        MinHeight="650"
        Icon="icon.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}"
        AllowDrop="True"
        PreviewDragOver="OnFileDragOver"
        Drop="OnFileDrop"
        KeyDown="OnWindowKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding NewPlayerMorphCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewNpcMorphCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenPackageCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseWorkspaceCommand}" />
    </Window.InputBindings>
    <!-- Window resources keep editor-specific templates local; shared primitives live in EditorTheme.xaml. -->
    <Window.Resources>
        <Style x:Key="PccContextAction" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetachedMeshWorkspace}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PccContextSeparator" TargetType="Separator">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetachedMeshWorkspace}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PaneSplitterStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Grip" Width="1" HorizontalAlignment="Center"
                                    Background="{DynamicResource BorderBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Width" Value="2" />
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Grip" Property="Width" Value="2" />
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MorphFeatureEditorTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="3,8" ToolTip="{Binding Description}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,5,0,0" IsEnabled="{Binding IsEditable}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}"
                                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PreviewMouseLeftButtonDown="OnEditorSliderStarted"
                                PreviewMouseLeftButtonUp="OnEditorSliderCompleted" />
                        <TextBox Grid.Column="1" Margin="7,0,0,0" Padding="5,3"
                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G6}}"
                                 PreviewKeyDown="OnNumericValueKeyDown"
                                 GotKeyboardFocus="OnNumericValueGotFocus"
                                 PreviewMouseWheel="OnNumericValueMouseWheel"
                                 ToolTip="{DynamicResource loc_View_MainWindow_TypeAnyFiniteValueOrUseTheMouseWheel01Ctrl1Shift10Enabl}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MaterialScalarEditorTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="3,8" ToolTip="{Binding Description}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" Background="{DynamicResource BadgeBackground}" BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource loc_View_MainWindow_MATERIAL}" Foreground="{DynamicResource Accent}" FontSize="8" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}"
                                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PreviewMouseLeftButtonDown="OnEditorSliderStarted"
                                PreviewMouseLeftButtonUp="OnEditorSliderCompleted" />
                        <TextBox Grid.Column="1" Margin="7,0,0,0" Padding="5,3"
                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G6}}"
                                 PreviewKeyDown="OnNumericValueKeyDown"
                                 GotKeyboardFocus="OnNumericValueGotFocus"
                                 PreviewMouseWheel="OnNumericValueMouseWheel"
                                 ToolTip="{DynamicResource loc_View_MainWindow_TypeAnyFiniteValueOrUseTheMouseWheel01Ctrl1Shift10Enabl}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MaterialColourEditorTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="3,8" ToolTip="{Binding Description}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" Background="{Binding PreviewBrush}" BorderBrush="{DynamicResource SwatchBorder}" BorderThickness="1" CornerRadius="3" />
                    <StackPanel Grid.Column="1" Margin="7,0">
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ValueSummary}" Foreground="{DynamicResource MutedText}" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{DynamicResource loc_View_MainWindow_Edit}" Command="{Binding EditCommand}" MinWidth="54" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MaterialTextureEditorTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="3,8" ToolTip="{Binding Description}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" Background="{DynamicResource TextureWellBackground}" BorderBrush="{DynamicResource SwatchBorder}" BorderThickness="1" CornerRadius="3"
                                MouseEnter="OnCommittedTextureMouseEnter">
                            <Image Source="{Binding PreviewThumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border.ToolTip>
                                <Border Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" Padding="8">
                                    <StackPanel>
                                        <Image Source="{Binding PreviewThumbnail}" Width="192" Height="192"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource SecondaryText}"
                                                   FontSize="10" Margin="0,6,0,0" MaxWidth="260" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" Foreground="{DynamicResource MutedText}"
                                                   FontSize="10" Margin="0,3,0,0" MaxWidth="260" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Border.ToolTip>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryText}" FontSize="12" />
                            <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource SecondaryText}" FontSize="9" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Accent}" FontSize="9" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding RegistryStatusLabel}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegistryAvailable}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusPending}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <controls:SearchableTexturePicker Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="FileToolbar" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Menu VerticalAlignment="Center">
                        <MenuItem Header="{DynamicResource loc_View_MainWindow_File}" Height="30" MinWidth="54">
                            <MenuItem Header="{DynamicResource loc_View_MainWindow_NewPlayerMorph}" Command="{Binding NewPlayerMorphCommand}" InputGestureText="{DynamicResource loc_Shortcut_NewPlayer}" />
                            <MenuItem Header="{DynamicResource loc_View_MainWindow_NewNpcMorph}" Command="{Binding NewNpcMorphCommand}" InputGestureText="{DynamicResource loc_Shortcut_NewNpc}" />
                            <MenuItem Header="{DynamicResource loc_View_MainWindow_OpenPackage}" Command="{Binding OpenPackageCommand}" InputGestureText="{DynamicResource loc_Shortcut_Open}" />
                            <MenuItem Header="{DynamicResource loc_View_MainWindow_SavePackage}" Command="{Binding SaveCommand}" InputGestureText="{DynamicResource loc_Shortcut_Save}" />
                            <MenuItem Header="{DynamicResource loc_FileSave_SaveAs}" Command="{Binding SaveAsCommand}" InputGestureText="{DynamicResource loc_Shortcut_SaveAs}" />
                            <Separator />
                            <MenuItem Header="{DynamicResource loc_View_MainWindow_Recent}" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding HasRecentFiles}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding FilePath}" />
                                        <Setter Property="Command" Value="{Binding OpenCommand}" />
                                        <Setter Property="ToolTip" Value="{Binding FilePath}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{DynamicResource loc_View_MainWindow_Close}" Command="{Binding CloseWorkspaceCommand}" InputGestureText="{DynamicResource loc_Shortcut_Close}" />
                            <MenuItem x:Name="SettingsMenuItem" Header="{DynamicResource loc_Settings_Title}" Click="OnSettingsClick">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource loc_About_Menu}">
                                <MenuItem Header="{DynamicResource loc_About_NexusMods}" Click="OnNexusModsClick" />
                                <MenuItem Header="{DynamicResource loc_About_GitHub}" Click="OnGitHubClick" />
                                <MenuItem Header="{DynamicResource loc_About_Donate}" Click="OnDonateClick" />
                                <Separator />
                                <MenuItem Header="{DynamicResource loc_About_AboutMfe}" Click="OnAboutMfeClick" />
                            </MenuItem>
                            <MenuItem Header="{DynamicResource loc_View_MainWindow_Exit}" Command="{Binding ExitCommand}" />
                        </MenuItem>
                    </Menu>
                    <Button Content="{DynamicResource loc_View_MainWindow_MeshTextureDatabases}" Command="{Binding TextureRegistrySettingsCommand}"
                            Height="30" Padding="10,3" Margin="7,0,0,0"
                            ToolTip="{DynamicResource loc_View_MainWindow_ManageTheGameWideTexture2DRegistries}" />
                    <Border Width="38" Height="38" Margin="14,0,0,0" Padding="2" CornerRadius="5"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                            Visibility="{Binding HasWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image Source="{Binding WorkspaceGameIcon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PackageDisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{DynamicResource loc_View_MainWindow_BioMorphFaceGeometryAndMaterialEditor}" Foreground="{DynamicResource MutedText}" FontSize="11" />
                </StackPanel>
                <StackPanel x:Name="PreviewToolbar" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource loc_View_MainWindow_Material}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <ComboBox Width="108" ItemsSource="{Binding RenderModes}" SelectedItem="{Binding RenderMode}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource PreviewRenderModeLabelConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource loc_View_MainWindow_LOD}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="14,0,7,0" />
                    <ComboBox Width="74"
                              ItemsSource="{Binding PreviewLods}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="LodIndex"
                              SelectedValue="{Binding PreviewLod}" />
                    <TextBlock Text="{DynamicResource loc_View_MainWindow_Lighting}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="14,0,7,0" />
                    <ComboBox Width="120"
                              ItemsSource="{Binding LightingPresets}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Preset"
                              SelectedValue="{Binding LightingPreset}" />
                    <CheckBox Content="{DynamicResource loc_View_MainWindow_PostProcessing}" IsChecked="{Binding PostProcessingEnabled}" Margin="14,0,0,0" />
                    <CheckBox Content="{DynamicResource loc_View_MainWindow_ExtendedSliders}" IsChecked="{Binding ExtendedSliders}" Margin="14,0,0,0"
                              ToolTip="{DynamicResource loc_View_MainWindow_AllowSignedZeroCentredSliderRangesTypedValuesRemainUnre}" />
                    <CheckBox Content="{DynamicResource loc_View_MainWindow_Wireframe}" IsChecked="{Binding Wireframe}" Margin="14,0,0,0" />
                    <CheckBox Content="{DynamicResource loc_View_MainWindow_HairHat}" IsChecked="{Binding ShowAttachment}" Margin="14,0,0,0"
                              ToolTip="{DynamicResource loc_View_MainWindow_ShowOrHideTheResolvedHairHatOrAccessoryMesh}" />
                </StackPanel>
            </Grid>
        </Border>

        <controls:PaneLayoutGrid x:Name="WorkspaceLayout" Grid.Row="1">
            <controls:PaneLayoutGrid.ColumnDefinitions>
                <ColumnDefinition x:Name="FaceBrowserColumn" Width="270" MinWidth="180" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:Name="FaceEditorColumn" Width="600" MinWidth="600" />
            </controls:PaneLayoutGrid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource loc_View_MainWindow_BIOMORPHFACEEXPORTS}" Foreground="{DynamicResource MutedText}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,9" />
                    <TextBox Grid.Row="1"
                             Text="{Binding FaceSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="7,5"
                             Margin="0,0,0,9"
                             ToolTip="{DynamicResource loc_View_MainWindow_SearchByExportNameOrFullInstancedPath}"
                             AutomationProperties.Name="{DynamicResource loc_View_MainWindow_SearchBioMorphFaceExports}" />
                    <ListBox x:Name="FaceList" Grid.Row="2"
                             ItemsSource="{Binding FilteredFaces}"
                             SelectedItem="{Binding SelectedFace}"
                             MouseDoubleClick="OnFaceListDoubleClick"
                             PreviewMouseRightButtonDown="OnFaceListRightButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Opened="OnFaceContextMenuOpened">
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_ExportTSERON}" Command="{Binding ExportTseMaterialsCommand}"
                                          Visibility="{Binding IsDetachedMeshWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_ImportTSERON}" Command="{Binding ImportTseMaterialsCommand}"
                                          Visibility="{Binding IsDetachedMeshWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_CloneMorph}" Style="{StaticResource PccContextAction}" Command="{Binding CloneMorphCommand}" />
                                <MenuItem Header="{DynamicResource loc_View_ConvertMorphWindow_ConvertMorph}" Style="{StaticResource PccContextAction}" Command="{Binding ConvertMorphCommand}" />
                                <Separator Style="{StaticResource PccContextSeparator}" />
                                <MenuItem Header="{DynamicResource loc_RonFiles_ImportMorphFace}" Style="{StaticResource PccContextAction}" Command="{Binding ImportMorphFaceRonCommand}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_ExportMorphAsRON}" Style="{StaticResource PccContextAction}" Command="{Binding ExportMorphRonCommand}"
                                          ToolTip="{Binding MorphRonExportUnavailableReason}" ToolTipService.ShowOnDisabled="True" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_ExportToPCC}" Command="{Binding SaveMorphToPccCommand}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_ExportMorphAsMesh}" Style="{StaticResource PccContextAction}">
                                    <MenuItem Header="{DynamicResource loc_View_MainWindow_PSK}" Command="{Binding ExportMorphPskCommand}" />
                                    <MenuItem Header="{DynamicResource loc_View_MainWindow_GlTF}" Command="{Binding ExportMorphGltfCommand}" />
                                </MenuItem>
                                <Separator Style="{StaticResource PccContextSeparator}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_AssignMorphToActor}" ToolTip="{DynamicResource loc_ActorAssignment_MorphTooltip}" Style="{StaticResource PccContextAction}" Command="{Binding AssignMorphToActorCommand}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_AssignMaterialsToActor}" ToolTip="{DynamicResource loc_ActorAssignment_MaterialsTooltip}" Style="{StaticResource PccContextAction}" Command="{Binding AssignMaterialsToActorCommand}" />
                                <Separator Visibility="{Binding IsMaterialFileWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuItem Header="{DynamicResource loc_RonFiles_ExportMorphs}" Style="{StaticResource PccContextAction}" Command="{Binding ExportMorphFeaturesRonCommand}" />
                                <MenuItem Header="{DynamicResource loc_RonFiles_ImportMorphs}" Style="{StaticResource PccContextAction}" Command="{Binding ImportMorphFeaturesRonCommand}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_ExportMaterials}" Command="{Binding ExportMaterialsCommand}"
                                          Visibility="{Binding IsMaterialFileWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_ImportMaterials}" Command="{Binding ImportMaterialsCommand}"
                                          Visibility="{Binding IsMaterialFileWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Separator Style="{StaticResource PccContextSeparator}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_CopyMorphData}" Style="{StaticResource PccContextAction}" Command="{Binding CopyMorphDataCommand}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_PasteMorphData}" Style="{StaticResource PccContextAction}" Command="{Binding PasteMorphDataCommand}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_CopyMaterialData}" Style="{StaticResource PccContextAction}" Command="{Binding CopyMaterialDataCommand}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_PasteMaterialData}" Style="{StaticResource PccContextAction}" Command="{Binding PasteMaterialDataCommand}" />
                                <Separator Style="{StaticResource PccContextSeparator}" />
                                <MenuItem Header="{DynamicResource loc_View_MainWindow_DeleteMorph}" Style="{StaticResource PccContextAction}" Command="{Binding DeleteMorphCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border controls:ArchetypeTag.Code="{Binding ProfileTag}"
                                            CornerRadius="3"
                                            Padding="5,2"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProfileTag}"
                                                   Foreground="{DynamicResource OnColourText}"
                                                   FontSize="9"
                                                   FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{DynamicResource loc_View_MainWindow_LoadSelectedFace}" Command="{Binding LoadSelectedFaceCommand}" />
                        <Button x:Name="CommitFaceButton" Grid.Column="1" Content="{DynamicResource loc_UnsavedChangesWindow_Commit}" Command="{Binding CommitCommand}" Margin="7,0,0,0"
                                Visibility="{Binding CanCommitFace, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="{DynamicResource loc_View_MainWindow_CommitTheLoadedFaceToTheTemporaryPackageWorkspaceWithou}" />
                    </Grid>
                    <Button Grid.Row="4" Content="{DynamicResource loc_View_MainWindow_FixMorph}" Command="{Binding FixMorphCommand}" Margin="0,7,0,0"
                            Visibility="{Binding CanFixMorph, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{DynamicResource loc_View_MainWindow_RebuildThisFaceFromTheProfileSCanonicalBaseHeadRestorin}" />
                    <Border Grid.Row="5" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="11" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding LoadedFacePath}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" FontSize="11" />
                            <TextBlock Text="{Binding FaceDetails}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Thumb x:Name="FaceBrowserSplitter" Grid.Column="1"
                          Style="{StaticResource PaneSplitterStyle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          DragStarted="OnPaneDragStarted" DragDelta="OnPaneDragDelta" DragCompleted="OnPaneDragCompleted"
                          KeyDown="OnPaneResizeKeyDown"
                          ToolTip="{DynamicResource loc_View_MainWindow_DragToResizeTheFaceBrowser}"
                          AutomationProperties.Name="{DynamicResource loc_View_MainWindow_ResizeFaceBrowser}" />

            <Grid Grid.Column="2" x:Name="PreviewHost" Background="{DynamicResource PreviewHostBackground}" ClipToBounds="True" Focusable="True">
                <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="-1" />
                    </Image.RenderTransform>
                </Image>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{DynamicResource loc_View_MainWindow_HEADPREVIEW}" Foreground="{DynamicResource PlaceholderText}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Foreground="{DynamicResource MutedText}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource loc_View_MainWindow_OpenAPackageContainingBioMorphFaceExports}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWorkspace}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource loc_View_MainWindow_NoFaceLoaded}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Background="{DynamicResource PreviewHintBackground}" BorderBrush="{DynamicResource HintBorder}" BorderThickness="1" Padding="10,7" CornerRadius="4">
                    <TextBlock Foreground="{DynamicResource SecondaryText}" FontSize="11" Text="{DynamicResource loc_View_MainWindow_LeftDragOrbitMiddleDragPanRightDragWheelZoom}" />
                </Border>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="14">
                    <Button Content="{DynamicResource loc_View_MainWindow_Front}" Click="OnFrontClick" Margin="0,0,6,0" />
                    <Button Content="{DynamicResource loc_View_MainWindow_View}" Click="OnThreeQuarterClick" />
                </StackPanel>
                <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                        Command="{Binding EditBackgroundColorCommand}"
                        ToolTip="{DynamicResource loc_View_MainWindow_ChangeThePreviewBackgroundColour}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="18" Height="18" Margin="0,0,7,0"
                                Background="{Binding BackgroundPreviewBrush}"
                                BorderBrush="{DynamicResource SwatchBorder}" BorderThickness="1" CornerRadius="3" />
                        <TextBlock Text="{DynamicResource loc_View_MainWindow_Background}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel VerticalAlignment="Top" Margin="14,62,14,0">
                    <Border x:Name="CustomMaterialDatabaseWarning" Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource StatusPending}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editor.HasLimitedCustomMaterials}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{DynamicResource loc_Shell_Warning_CustomMaterialDatabaseUnavailable}"
                                   Foreground="{DynamicResource StatusPending}" TextWrapping="Wrap" />
                    </Border>
                <Border Background="{DynamicResource ErrorBannerBackground}" BorderBrush="{DynamicResource ErrorBannerBorder}" BorderThickness="1" Padding="10" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="OnCopyErrorClick" Padding="2" MinWidth="24" Height="24"
                                    VerticalAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent"
                                    ToolTip="{DynamicResource loc_View_MainWindow_CopyErrorMessage}">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="M 5,2 H 12 V 9 H 5 Z M 2,5 H 9 V 12 H 2 Z"
                                          Stroke="{DynamicResource CopyErrorStroke}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" Fill="Transparent" />
                                </Viewbox>
                            </Button>
                            <Button Content="×" Command="{Binding DismissErrorCommand}"
                                    Margin="4,0,0,0" Padding="5,0" MinWidth="24" Height="24"
                                    VerticalAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent"
                                    FontSize="16" FontWeight="SemiBold"
                                    ToolTip="{DynamicResource loc_View_MainWindow_DismissError}" />
                        </StackPanel>
                    </Grid>
                </Border>
                </StackPanel>
                <Border Background="{DynamicResource BusyOverlayBackground}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                        <TextBlock Text="{DynamicResource loc_View_MainWindow_ReadingPackageAndMorphData}" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <Button Content="{DynamicResource loc_View_MainWindow_CancelNPCImport}" Command="{Binding CancelNpcImportCommand}"
                                Visibility="{Binding CanCancelNpcImport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,12,0,0" Padding="10,4" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Thumb x:Name="FaceEditorSplitter" Grid.Column="3"
                          Style="{StaticResource PaneSplitterStyle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          DragStarted="OnPaneDragStarted" DragDelta="OnPaneDragDelta" DragCompleted="OnPaneDragCompleted"
                          KeyDown="OnPaneResizeKeyDown"
                          ToolTip="{DynamicResource loc_View_MainWindow_DragToResizeTheFaceEditor}"
                          AutomationProperties.Name="{DynamicResource loc_View_MainWindow_ResizeFaceEditor}" />

            <Border Grid.Column="4" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="1,0,1,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource loc_View_MainWindow_FACEEDITOR}" Foreground="{DynamicResource MutedText}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel x:Name="EditorActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{DynamicResource loc_View_MainWindow_Undo}" Command="{Binding Editor.UndoCommand}" MinWidth="66" Padding="9,5" Margin="0,0,6,0" />
                            <Button Content="{DynamicResource loc_View_MainWindow_Redo}" Command="{Binding Editor.RedoCommand}" MinWidth="66" Padding="9,5" Margin="0,0,6,0" />
                            <Button x:Name="SetToDefaultsButton" Content="{DynamicResource loc_View_MainWindow_SetToDefaults}"
                                    Command="{Binding Editor.SetToDefaultsCommand}"
                                    MinWidth="104" Padding="9,5" Margin="0,0,6,0" />
                            <Button x:Name="GlobalRandomiseButton" Content="{DynamicResource loc_View_MainWindow_Randomise}"
                                    Command="{Binding Editor.RandomiseCommand}"
                                    MinWidth="78" Padding="9,5" />
                        </StackPanel>
                        <Grid x:Name="RandomisationControls" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MorphRandomisationStrengthLabel" Text="{DynamicResource loc_View_MainWindow_MorphRandomisationStrength}"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Visibility="{Binding Editor.HasMorphControls, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Slider x:Name="MorphRandomisationStrengthSlider" Grid.Column="1"
                                    Minimum="0" Maximum="100" TickFrequency="1" SmallChange="10" LargeChange="10"
                                    Value="{Binding MorphRandomisationStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding Editor.RandomiseMorphs}"
                                    Visibility="{Binding Editor.HasMorphControls, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="MorphRandomisationStrengthValue" Grid.Column="2"
                                       Style="{StaticResource FieldLabel}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Text="{Binding MorphRandomisationStrength, StringFormat={}{0}%}"
                                       Visibility="{Binding Editor.HasMorphControls, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <CheckBox x:Name="RandomiseMorphsCheckBox" Grid.Column="3" Content="{DynamicResource loc_View_MainWindow_RandomiseMorphs}"
                                      IsChecked="{Binding RandomiseMorphs, Mode=TwoWay}"
                                      IsEnabled="{Binding Editor.AllowsMorphRandomisation}"
                                      Visibility="{Binding Editor.HasMorphControls, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="14,0,0,0" VerticalAlignment="Center" />

                            <TextBlock x:Name="MaterialRandomisationStrengthLabel" Grid.Row="1"
                                       Text="{DynamicResource loc_View_MainWindow_MaterialRandomisationStrength}" Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="0,3,12,0" />
                            <Slider x:Name="MaterialRandomisationStrengthSlider" Grid.Row="1" Grid.Column="1"
                                    Minimum="0" Maximum="100" TickFrequency="1" SmallChange="10" LargeChange="10"
                                    Value="{Binding MaterialRandomisationStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding Editor.RandomiseMaterials}"
                                    Margin="0,3,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MaterialRandomisationStrengthValue" Grid.Row="1" Grid.Column="2"
                                       Style="{StaticResource FieldLabel}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Text="{Binding MaterialRandomisationStrength, StringFormat={}{0}%}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,3,0,0" />
                            <CheckBox x:Name="RandomiseMaterialsCheckBox" Grid.Row="1" Grid.Column="3" Content="{DynamicResource loc_View_MainWindow_RandomiseMaterials}"
                                      IsChecked="{Binding RandomiseMaterials, Mode=TwoWay}"
                                      IsEnabled="{Binding Editor.AllowsMaterialRandomisation}"
                                      Margin="14,3,0,0" VerticalAlignment="Center" />

                            <CheckBox x:Name="CursedModeCheckBox" Grid.Row="2" Grid.Column="3" Content="{DynamicResource loc_View_MainWindow_CursedMode}"
                                      IsChecked="{Binding CursedMode, Mode=TwoWay}"
                                      IsEnabled="{Binding Editor.AllowsCursedRandomisation}"
                                      Margin="14,3,0,0" VerticalAlignment="Center"
                                      ToolTip="{DynamicResource loc_View_MainWindow_EnableThisOnlyIfYouAreMentallyDisturbedAndOrAreMgamerz}" />
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="AttachmentMeshPanel" Grid.Row="1" Margin="0,0,0,10"
                                IsEnabled="{Binding Editor.CanEditAttachments}">
                        <TextBlock x:Name="HairAccessoryMeshesLabel"
      		    	             Text="{Binding Editor.AttachmentMeshesHeading}"
           		                 Style="{StaticResource FieldLabel}"
           		                 Margin="0,0,0,6" />
                        <TextBlock x:Name="AttachmentRegistryNotice" Text="{Binding Editor.AttachmentRegistryNotice}"
                                   Foreground="{DynamicResource StatusPending}" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding Editor.IsMeshDatabaseUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Editor.AttachmentMeshes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" ToolTip="{Binding HoverText}"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <controls:SearchableMeshPicker Grid.Column="1" />
                                        <Button Grid.Column="2" Content="{DynamicResource loc_View_MainWindow_Randomise}" Command="{Binding RandomiseCommand}"
                                                Visibility="{Binding HasRandomiseCommand, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Margin="5,0,0,0" Padding="8,2" VerticalAlignment="Center"
                                                ToolTip="{DynamicResource loc_View_MainWindow_RandomiseTheHairMeshAndItsEligibleScalpPairing}"
                                                AutomationProperties.Name="{DynamicResource loc_View_MainWindow_RandomiseHairMesh}" />
                                        <CheckBox Grid.Column="3" Style="{StaticResource RandomisationPadlock}"
                                                  IsChecked="{Binding IsRandomisationLocked, Mode=TwoWay}"
                                                  Margin="5,0,0,0"
                                                  ToolTip="{DynamicResource loc_View_MainWindow_ToggleThisAttachmentSRandomisationLockWhenLockedThisCat}"
                                                  AutomationProperties.Name="{DynamicResource loc_View_MainWindow_ToggleAttachmentRandomisationLockWhenLockedThisCategory}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TabControl Grid.Row="2" SelectedIndex="0">
                        <TabItem Header="{DynamicResource loc_View_MainWindow_Features}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource SectionBackground}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="10,8"
                                        Visibility="{Binding Editor.HasCustomMaterialSlots, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource loc_View_MainWindow_CUSTOMMESHMATERIALASSIGNMENTS}" Style="{StaticResource FieldLabel}"
                                                   Margin="2,0,0,7" />
                                        <ItemsControl ItemsSource="{Binding Editor.CustomMaterialSlots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SecondaryText}" FontSize="10" />
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource LocalDetailText}" FontSize="9" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  ToolTip="{DynamicResource loc_View_MainWindow_AssignOneEvidenceBackedMaterialFamilyToThisUsedMeshSlot}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            <TabControl Grid.Row="1" ItemsSource="{Binding Editor.Categories}"
                                        SelectedItem="{Binding Editor.SelectedCategory, Mode=TwoWay}"
                                        Background="{DynamicResource InputBackground}">
                                <TabControl.ItemContainerStyle>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                </TabControl.ItemContainerStyle>
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid Background="{DynamicResource InputBackground}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{DynamicResource SectionBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryText}" FontSize="10" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Foreground="{DynamicResource Accent}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="8,4,8,10">
                                                    <ItemsControl ItemsSource="{Binding SliderGroups}"
                                                                  Visibility="{Binding HasSliders, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <Grid Margin="2,13,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                                                        <Button Grid.Column="1" Content="{DynamicResource loc_View_MainWindow_Randomise}" Command="{Binding RandomiseCommand}"
                                                                                Visibility="{Binding HasRandomisableValues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Padding="7,2" FontSize="9" MinWidth="58"
                                                                                ToolTip="{DynamicResource loc_View_MainWindow_RandomiseOnlyTheMorphSlidersInThisSubcategory}" />
                                                                        <CheckBox Grid.Column="2" Style="{StaticResource RandomisationPadlock}"
                                                                                  IsChecked="{Binding Inclusion.IsLocked, Mode=TwoWay}"
                                                                                  Visibility="{Binding HasRandomisableValues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                  Margin="5,0,0,0"
                                                                                  ToolTip="{DynamicResource loc_View_MainWindow_ToggleThisSubcategorySRandomisationLockWhenLockedThisCa}"
                                                                                  AutomationProperties.Name="{DynamicResource loc_View_MainWindow_ToggleSubcategoryRandomisationLock}" />
                                                                    </Grid>
                                                                    <ItemsControl ItemsSource="{Binding MorphFeatures}" ItemTemplate="{StaticResource MorphFeatureEditorTemplate}" />
                                                                    <ItemsControl ItemsSource="{Binding Scalars}" ItemTemplate="{StaticResource MaterialScalarEditorTemplate}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <StackPanel Visibility="{Binding HasColours, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ItemsControl ItemsSource="{Binding ColourGroups}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <Grid Margin="2,13,0,3">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                                                            <Button Grid.Column="1" Content="{DynamicResource loc_View_MainWindow_Randomise}" Command="{Binding RandomiseCommand}"
                                                                                    Visibility="{Binding HasRandomisableValues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                    Padding="7,2" FontSize="9" MinWidth="58"
                                                                                    ToolTip="{DynamicResource loc_View_MainWindow_RandomiseOnlyTheseAuditedColoursAndSelectorChannels}" />
                                                                            <CheckBox Grid.Column="2" Style="{StaticResource RandomisationPadlock}"
                                                                                      IsChecked="{Binding Inclusion.IsLocked, Mode=TwoWay}"
                                                                                      Visibility="{Binding HasRandomisableValues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                      Margin="5,0,0,0"
                                                                                      ToolTip="{DynamicResource loc_View_MainWindow_ToggleTheseColoursRandomisationLockWhenLockedThisCatego}"
                                                                                      AutomationProperties.Name="{DynamicResource loc_View_MainWindow_ToggleColourRandomisationLock}" />
                                                                        </Grid>
                                                                        <ItemsControl ItemsSource="{Binding Values}" ItemTemplate="{StaticResource MaterialColourEditorTemplate}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasTextures, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid Margin="2,13,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource loc_View_MainWindow_TEXTURES}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Content="{DynamicResource loc_View_MainWindow_Randomise}" Command="{Binding TextureRandomiseCommand}"
                                                                    Visibility="{Binding CanRandomiseTextures, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Padding="7,2" FontSize="9" MinWidth="58"
                                                                    ToolTip="{DynamicResource loc_View_MainWindow_RandomiseOnlyEligiblePairedTextureFamiliesInThisCategor}" />
                                                            <CheckBox Grid.Column="2" Style="{StaticResource RandomisationPadlock}"
                                                                      IsChecked="{Binding TextureInclusion.IsLocked, Mode=TwoWay}"
                                                                      Visibility="{Binding CanRandomiseTextures, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                      Margin="5,0,0,0"
                                                                      ToolTip="{DynamicResource loc_View_MainWindow_ToggleTheseTexturesRandomisationLockWhenLockedThisCateg}"
                                                                      AutomationProperties.Name="{DynamicResource loc_View_MainWindow_ToggleTextureRandomisationLock}" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Textures}" ItemTemplate="{StaticResource MaterialTextureEditorTemplate}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource loc_View_MainWindow_Bones}" IsEnabled="{Binding Editor.CanEditBones}">
                            <Grid Background="{DynamicResource InputBackground}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource SectionBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                    <TextBlock Text="{DynamicResource loc_View_MainWindow_RawFinalSkeletonTranslationEditingFeatureControlsAreUsu}" Foreground="{DynamicResource SecondaryText}" FontSize="10" TextWrapping="Wrap" />
                                </Border>
                                <ListBox x:Name="BoneList" Grid.Row="1" ItemsSource="{Binding Editor.BoneTransforms}"
                                         SelectedItem="{Binding Editor.SelectedBoneTransform, Mode=TwoWay}"
                                         BorderThickness="0" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource PrimaryText}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <!-- The default disabled ListBox template paints white; keep the themed background while busy. -->
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <Border Padding="1" BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                                                    SnapsToDevicePixels="True">
                                                <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </ScrollViewer>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsGrouping" Value="True" />
                                                        <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                                            <Setter Property="Padding" Value="0" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                    Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <Border Padding="9,8" Cursor="Hand" PreviewMouseLeftButtonDown="OnBoneHeaderMouseLeftButtonDown">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BoneSelectionBackground}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="18" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding BoneName}" Foreground="{DynamicResource PrimaryText}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <Button Content="{DynamicResource loc_View_MainWindow_Reset}" Command="{Binding ResetCommand}"
                                                                    Grid.Column="1" Margin="5,0,5,0"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Padding="7,2" FontSize="9" ToolTip="{DynamicResource loc_View_MainWindow_RestoreThisBoneToItsLoadedTranslation}" />
                                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.2"
                                                                  Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                                <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" CenterX="4" CenterY="2" /></Setter.Value></Setter>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Margin="9,0,9,10"
                                                                Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <controls:BoneTransformControl HorizontalAlignment="Stretch" />
                                                        <Grid Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="5" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="5" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid>
                                                                <TextBox DataContext="{Binding X}" Padding="18,3,4,3" FontSize="10"
                                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G6}}"
                                                                         PreviewKeyDown="OnNumericValueKeyDown" GotKeyboardFocus="OnNumericValueGotFocus"
                                                                         PreviewMouseWheel="OnNumericValueMouseWheel" />
                                                                <TextBlock Text="{DynamicResource loc_View_MainWindow_X}" Foreground="{DynamicResource Accent}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                            </Grid>
                                                            <Grid Grid.Column="2">
                                                                <TextBox DataContext="{Binding Y}" Padding="18,3,4,3" FontSize="10"
                                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G6}}"
                                                                         PreviewKeyDown="OnNumericValueKeyDown" GotKeyboardFocus="OnNumericValueGotFocus"
                                                                         PreviewMouseWheel="OnNumericValueMouseWheel" />
                                                                <TextBlock Text="{DynamicResource loc_View_MainWindow_Y}" Foreground="{DynamicResource Accent}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                            </Grid>
                                                            <Grid Grid.Column="4">
                                                                <TextBox DataContext="{Binding Z}" Padding="18,3,4,3" FontSize="10"
                                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G6}}"
                                                                         PreviewKeyDown="OnNumericValueKeyDown" GotKeyboardFocus="OnNumericValueGotFocus"
                                                                         PreviewMouseWheel="OnNumericValueMouseWheel" />
                                                                <TextBlock Text="{DynamicResource loc_View_MainWindow_Z}" Foreground="{DynamicResource Accent}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                            </Grid>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </controls:PaneLayoutGrid>

        <Border Grid.Row="2" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="UpdateAvailableBadge" Grid.Column="1" Visibility="Collapsed" Margin="12,3,0,3"
                        Content="{DynamicResource loc_Updates_UpdateAvailable}" FontSize="11" FontWeight="SemiBold"
                        Background="#F4A340" Foreground="#211407" BorderBrush="#F4A340" Padding="9,2"
                        Click="OnUpdateAvailableClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Badge" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Badge" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource PrimaryText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
