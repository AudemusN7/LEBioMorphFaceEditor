<Window x:Class="MorphFaceEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MorphFaceEditor.Controls"
        Title="BioMorphFace Editor"
        Width="1540"
        Height="820"
        MinWidth="1100"
        MinHeight="650"
        Icon="icon.ico"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}"
        AllowDrop="True"
        PreviewDragOver="OnFileDragOver"
        Drop="OnFileDrop"
        WindowStartupLocation="CenterScreen">
    <!-- Window resources keep editor-specific templates local; shared primitives live in EditorTheme.xaml. -->
    <Window.Resources>
        <Style x:Key="PaneSplitterStyle" TargetType="{x:Type GridSplitter}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Grip" Width="1" HorizontalAlignment="Center"
                                    Background="{StaticResource BorderBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Width" Value="2" />
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Grip" Property="Width" Value="2" />
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MorphFeatureEditorTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="3,8" ToolTip="{Binding Description}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <Grid Margin="0,5,0,0" IsEnabled="{Binding IsEditable}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}"
                                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PreviewMouseLeftButtonDown="OnEditorSliderStarted"
                                PreviewMouseLeftButtonUp="OnEditorSliderCompleted" />
                        <TextBox Grid.Column="1" Margin="7,0,0,0" Padding="5,3"
                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G6}}"
                                 PreviewKeyDown="OnNumericValueKeyDown"
                                 GotKeyboardFocus="OnNumericValueGotFocus"
                                 LostKeyboardFocus="OnNumericValueLostFocus"
                                 PreviewMouseWheel="OnNumericValueMouseWheel"
                                 ToolTip="Type any finite value, or use the mouse wheel (0.1; Ctrl 1; Shift 10). Enable Extended Sliders for signed, zero-centred ranges." />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MaterialScalarEditorTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="3,8" ToolTip="{Binding Description}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" Background="#24313A" BorderBrush="#3E5863" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="8,0,0,0">
                            <TextBlock Text="MATERIAL" Foreground="{StaticResource Accent}" FontSize="8" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}"
                                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PreviewMouseLeftButtonDown="OnEditorSliderStarted"
                                PreviewMouseLeftButtonUp="OnEditorSliderCompleted" />
                        <TextBox Grid.Column="1" Margin="7,0,0,0" Padding="5,3"
                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G6}}"
                                 PreviewKeyDown="OnNumericValueKeyDown"
                                 GotKeyboardFocus="OnNumericValueGotFocus"
                                 LostKeyboardFocus="OnNumericValueLostFocus"
                                 PreviewMouseWheel="OnNumericValueMouseWheel"
                                 ToolTip="Type any finite value, or use the mouse wheel (0.1; Ctrl 1; Shift 10). Enable Extended Sliders for signed, zero-centred ranges." />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MaterialColourEditorTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="3,8" ToolTip="{Binding Description}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" Background="{Binding PreviewBrush}" BorderBrush="#88939CA7" BorderThickness="1" CornerRadius="3" />
                    <StackPanel Grid.Column="1" Margin="7,0">
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ValueSummary}" Foreground="{StaticResource MutedText}" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Edit…" Command="{Binding EditCommand}" MinWidth="54" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MaterialTextureEditorTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="3,8" ToolTip="{Binding Description}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" Background="#0B0E12" BorderBrush="#88939CA7" BorderThickness="1" CornerRadius="3">
                            <Image Source="{Binding PreviewThumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryText}" FontSize="12" />
                            <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource SecondaryText}" FontSize="9" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource Accent}" FontSize="9" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding RegistryStatusLabel}" Foreground="{StaticResource MutedText}" FontSize="9" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    <controls:SearchableTexturePicker Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open PCC" Command="{Binding OpenPackageCommand}" MinWidth="96" Height="30" Padding="10,3" />
                    <Button Content="Import Morph" Command="{Binding ImportMorphCommand}" MinWidth="108" Height="30" Padding="10,3" Margin="7,0,0,0"
                            ToolTip="Create a BioMorphFace from a TSE RON or project a baked PSK, glTF, or MD5 mesh onto the selected face profile" />
                    <Button Content="Save PCC" Command="{Binding SaveCommand}" MinWidth="82" Height="30" Padding="10,3" Margin="7,0,0,0" />
                    <Button Content="Save Morph to PCC" Command="{Binding SaveMorphToPccCommand}" MinWidth="142" Height="30" Padding="10,3" Margin="7,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PackageDisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="BioMorphFace geometry and material editor" Foreground="{StaticResource MutedText}" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Material" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <ComboBox Width="108" ItemsSource="{Binding RenderModes}" SelectedItem="{Binding RenderMode}" />
                    <TextBlock Text="LOD" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="14,0,7,0" />
                    <ComboBox Width="74"
                              ItemsSource="{Binding PreviewLods}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="LodIndex"
                              SelectedValue="{Binding PreviewLod}" />
                    <TextBlock Text="Lighting" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="14,0,7,0" />
                    <ComboBox Width="120"
                              ItemsSource="{Binding LightingPresets}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Preset"
                              SelectedValue="{Binding LightingPreset}" />
                    <CheckBox Content="Extended Sliders" IsChecked="{Binding ExtendedSliders}" Margin="14,0,0,0"
                              ToolTip="Allow signed, zero-centred slider ranges. Typed values remain unrestricted in either mode." />
                    <CheckBox Content="Wireframe" IsChecked="{Binding Wireframe}" Margin="14,0,0,0" />
                    <CheckBox Content="Hair / hat" IsChecked="{Binding ShowAttachment}" Margin="14,0,0,0"
                              ToolTip="Show or hide the resolved hair, hat, or accessory mesh" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="220" MaxWidth="520" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="480" MinWidth="360" MaxWidth="760" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="BIOMORPHFACE EXPORTS" Foreground="{StaticResource MutedText}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,9" />
                    <TextBox Grid.Row="1"
                             Text="{Binding FaceSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="7,5"
                             Margin="0,0,0,9"
                             ToolTip="Search by export name or full instanced path"
                             AutomationProperties.Name="Search BioMorphFace exports" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredFaces}"
                             SelectedItem="{Binding SelectedFace}"
                             MouseDoubleClick="OnFaceListDoubleClick"
                             PreviewMouseRightButtonDown="OnFaceListRightButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Opened="OnFaceContextMenuOpened">
                                <MenuItem Header="Clone Morph…" Command="{Binding CloneMorphCommand}" />
                                <MenuItem Header="{Binding ConvertMorphHeader}" Command="{Binding ConvertMorphCommand}" />
                                <MenuItem Header="Export Morph as Mesh">
                                    <MenuItem Header="PSK…" Command="{Binding ExportMorphPskCommand}" />
                                    <MenuItem Header="glTF…" Command="{Binding ExportMorphGltfCommand}" />
                                    <MenuItem Header="MD5…" Command="{Binding ExportMorphMd5Command}" />
                                </MenuItem>
                                <MenuItem Header="Export Morph as RON" Command="{Binding ExportMorphRonCommand}" />
                                <Separator />
                                <MenuItem Header="Assign Morph to Actor…" Command="{Binding AssignMorphToActorCommand}" />
                                <MenuItem Header="Assign Materials to Actor…" Command="{Binding AssignMaterialsToActorCommand}" />
                                <Separator />
                                <MenuItem Header="Copy Morph Data" Command="{Binding CopyMorphDataCommand}" />
                                <MenuItem Header="Paste Morph Data" Command="{Binding PasteMorphDataCommand}" />
                                <MenuItem Header="Copy Material Data" Command="{Binding CopyMaterialDataCommand}" />
                                <MenuItem Header="Paste Material Data" Command="{Binding PasteMaterialDataCommand}" />
                                <Separator />
                                <MenuItem Header="Delete Morph" Command="{Binding DeleteMorphCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding ProfileTagColor}"
                                            CornerRadius="3"
                                            Padding="5,2"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProfileTag}"
                                                   Foreground="White"
                                                   FontSize="9"
                                                   FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Content="Load selected face" Command="{Binding LoadSelectedFaceCommand}" Margin="0,10,0,0" />
                    <Button Grid.Row="4" Content="Fix Morph" Command="{Binding FixMorphCommand}" Margin="0,7,0,0"
                            Visibility="{Binding CanFixMorph, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Rebuild this face from the profile's canonical base head, restoring the baked geometry/oracle relationship without changing its current slider values." />
                    <Border Grid.Row="5" Background="#151A20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="11" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding LoadedFacePath}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="11" />
                            <TextBlock Text="{Binding FaceDetails}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource PaneSplitterStyle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ToolTip="Drag to resize the face browser"
                          AutomationProperties.Name="Resize face browser" />

            <Grid Grid.Column="2" x:Name="PreviewHost" Background="#090C10" ClipToBounds="True" Focusable="True">
                <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="-1" />
                    </Image.RenderTransform>
                </Image>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="HEAD PREVIEW" Foreground="#526071" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Open a package containing BioMorphFace exports." Foreground="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Background="#C012171D" BorderBrush="#553A4653" BorderThickness="1" Padding="10,7" CornerRadius="4">
                    <TextBlock Foreground="{StaticResource SecondaryText}" FontSize="11" Text="Left drag: orbit   ·   Middle drag: pan   ·   Right drag / wheel: zoom" />
                </Border>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="14">
                    <Button Content="Front" Click="OnFrontClick" Margin="0,0,6,0" />
                    <Button Content="¾ View" Click="OnThreeQuarterClick" />
                </StackPanel>
                <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                        Command="{Binding EditBackgroundColorCommand}"
                        ToolTip="Change the preview background colour">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="18" Height="18" Margin="0,0,7,0"
                                Background="{Binding BackgroundPreviewBrush}"
                                BorderBrush="#88939CA7" BorderThickness="1" CornerRadius="3" />
                        <TextBlock Text="Background" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border VerticalAlignment="Top" Margin="14,62,14,0" Background="#DA4B2025" BorderBrush="#D5746670" BorderThickness="1" Padding="10" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFE2E4" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="×" Command="{Binding DismissErrorCommand}"
                                Margin="10,0,0,0" Padding="5,0" MinWidth="24" Height="24"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderBrush="Transparent"
                                FontSize="16" FontWeight="SemiBold"
                                ToolTip="Dismiss error" />
                    </Grid>
                </Border>
                <Border Background="#99090C10" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                        <TextBlock Text="Reading package and morph data…" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Style="{StaticResource PaneSplitterStyle}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ToolTip="Drag to resize the face editor"
                          AutomationProperties.Name="Resize face editor" />

            <Border Grid.Column="4" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="1,0,1,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FACE EDITOR" Foreground="{StaticResource MutedText}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Undo" Command="{Binding Editor.UndoCommand}" MinWidth="66" Padding="9,5" Margin="0,0,6,0" />
                            <Button Content="Redo" Command="{Binding Editor.RedoCommand}" MinWidth="66" Padding="9,5" Margin="0,0,6,0" />
                            <Button x:Name="SetToDefaultsButton" Content="Set to Defaults"
                                    Command="{Binding Editor.SetToDefaultsCommand}"
                                    MinWidth="104" Padding="9,5" Margin="0,0,6,0" />
                            <Button x:Name="GlobalRandomiseButton" Content="Randomise"
                                    Command="{Binding Editor.RandomiseCommand}"
                                    MinWidth="78" Padding="9,5" />
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MorphRandomisationStrengthLabel" Text="Morph Randomisation Strength"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <Slider x:Name="MorphRandomisationStrengthSlider" Grid.Column="1"
                                    Minimum="0" Maximum="100" TickFrequency="1" SmallChange="10" LargeChange="10"
                                    Value="{Binding MorphRandomisationStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding Editor.RandomiseMorphs}"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="MorphRandomisationStrengthValue" Grid.Column="2"
                                       Style="{StaticResource FieldLabel}"
                                       Foreground="{StaticResource SecondaryText}"
                                       Text="{Binding MorphRandomisationStrength, StringFormat={}{0}%}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <CheckBox x:Name="RandomiseMorphsCheckBox" Grid.Column="3" Content="Randomise Morphs"
                                      IsChecked="{Binding RandomiseMorphs, Mode=TwoWay}"
                                      IsEnabled="{Binding Editor.AllowsMorphRandomisation}"
                                      Margin="14,0,0,0" VerticalAlignment="Center" />

                            <TextBlock x:Name="MaterialRandomisationStrengthLabel" Grid.Row="1"
                                       Text="Material Randomisation Strength" Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="0,3,12,0" />
                            <Slider x:Name="MaterialRandomisationStrengthSlider" Grid.Row="1" Grid.Column="1"
                                    Minimum="0" Maximum="100" TickFrequency="1" SmallChange="10" LargeChange="10"
                                    Value="{Binding MaterialRandomisationStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding Editor.RandomiseMaterials}"
                                    Margin="0,3,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="MaterialRandomisationStrengthValue" Grid.Row="1" Grid.Column="2"
                                       Style="{StaticResource FieldLabel}"
                                       Foreground="{StaticResource SecondaryText}"
                                       Text="{Binding MaterialRandomisationStrength, StringFormat={}{0}%}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,3,0,0" />
                            <CheckBox x:Name="RandomiseMaterialsCheckBox" Grid.Row="1" Grid.Column="3" Content="Randomise Materials"
                                      IsChecked="{Binding RandomiseMaterials, Mode=TwoWay}"
                                      IsEnabled="{Binding Editor.AllowsMaterialRandomisation}"
                                      Margin="14,3,0,0" VerticalAlignment="Center" />

                            <CheckBox x:Name="CursedModeCheckBox" Grid.Row="2" Grid.Column="3" Content="Cursed Mode"
                                      IsChecked="{Binding CursedMode, Mode=TwoWay}"
                                      IsEnabled="{Binding Editor.AllowsCursedRandomisation}"
                                      Margin="14,3,0,0" VerticalAlignment="Center"
                                      ToolTip="Enable this only if you are mentally disturbed and/or are Mgamerz" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10" IsEnabled="{Binding Editor.CanEdit}">
                        <TextBlock x:Name="HairAccessoryMeshesLabel" Text="HAIR / ACCESSORY MESHES"
                                   Style="{StaticResource FieldLabel}" Margin="2,0,0,5" />
                        <ItemsControl ItemsSource="{Binding Editor.AttachmentMeshes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="124" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource SecondaryText}"
                                                   FontSize="10" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding Selected}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="Change this explicit BioMorphFace skeletal-mesh reference" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TabControl Grid.Row="2" SelectedIndex="0">
                        <TabItem Header="Features">
                            <TabControl ItemsSource="{Binding Editor.Categories}"
                                        SelectedItem="{Binding Editor.SelectedCategory, Mode=TwoWay}"
                                        Background="#151A20">
                                <TabControl.ItemContainerStyle>
                                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                </TabControl.ItemContainerStyle>
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid Background="#151A20">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Background="#1C242C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource SecondaryText}" FontSize="10" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Foreground="{StaticResource Accent}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="8,4,8,10">
                                                    <ItemsControl ItemsSource="{Binding SliderGroups}"
                                                                  Visibility="{Binding HasSliders, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <Grid Margin="2,13,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                                                        <Button Grid.Column="1" Content="Randomise" Command="{Binding RandomiseCommand}"
                                                                                Visibility="{Binding HasRandomisableValues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Padding="7,2" FontSize="9" MinWidth="58"
                                                                                ToolTip="Randomise only the morph sliders in this subcategory" />
                                                                        <CheckBox Grid.Column="2" Style="{StaticResource RandomisationIncludeToggle}"
                                                                                  IsChecked="{Binding Inclusion.IsIncluded, Mode=TwoWay}"
                                                                                  Visibility="{Binding HasRandomisableValues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                  Margin="5,0,0,0"
                                                                                  ToolTip="Include this subcategory when using the global Randomise button" />
                                                                    </Grid>
                                                                    <ItemsControl ItemsSource="{Binding MorphFeatures}" ItemTemplate="{StaticResource MorphFeatureEditorTemplate}" />
                                                                    <ItemsControl ItemsSource="{Binding Scalars}" ItemTemplate="{StaticResource MaterialScalarEditorTemplate}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <StackPanel Visibility="{Binding HasColours, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ItemsControl ItemsSource="{Binding ColourGroups}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <Grid Margin="2,13,0,3">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                                                            <Button Grid.Column="1" Content="Randomise" Command="{Binding RandomiseCommand}"
                                                                                    Visibility="{Binding HasRandomisableValues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                    Padding="7,2" FontSize="9" MinWidth="58"
                                                                                    ToolTip="Randomise only these audited colours and selector channels" />
                                                                            <CheckBox Grid.Column="2" Style="{StaticResource RandomisationIncludeToggle}"
                                                                                      IsChecked="{Binding Inclusion.IsIncluded, Mode=TwoWay}"
                                                                                      Visibility="{Binding HasRandomisableValues, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                      Margin="5,0,0,0"
                                                                                      ToolTip="Include this subcategory when using the global Randomise button" />
                                                                        </Grid>
                                                                        <ItemsControl ItemsSource="{Binding Values}" ItemTemplate="{StaticResource MaterialColourEditorTemplate}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding HasTextures, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid Margin="2,13,0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="TEXTURES" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Content="Randomise" Command="{Binding TextureRandomiseCommand}"
                                                                    Visibility="{Binding CanRandomiseTextures, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Padding="7,2" FontSize="9" MinWidth="58"
                                                                    ToolTip="Randomise only eligible paired texture families in this category" />
                                                            <CheckBox Grid.Column="2" Style="{StaticResource RandomisationIncludeToggle}"
                                                                      IsChecked="{Binding TextureInclusion.IsIncluded, Mode=TwoWay}"
                                                                      Visibility="{Binding CanRandomiseTextures, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                      Margin="5,0,0,0"
                                                                      ToolTip="Include this subcategory when using the global Randomise button" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Textures}" ItemTemplate="{StaticResource MaterialTextureEditorTemplate}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </TabItem>

                        <TabItem Header="Bones" IsEnabled="{Binding Editor.CanEdit}">
                            <Grid Background="#151A20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#1C242C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                    <TextBlock Text="Raw final-skeleton translation editing. Feature controls are usually the safer authoring surface." Foreground="{StaticResource SecondaryText}" FontSize="10" TextWrapping="Wrap" />
                                </Border>
                                <ListBox x:Name="BoneList" Grid.Row="1" ItemsSource="{Binding Editor.BoneTransforms}"
                                         SelectedItem="{Binding Editor.SelectedBoneTransform, Mode=TwoWay}"
                                         BorderThickness="0" Background="#151A20" Foreground="{StaticResource PrimaryText}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                            <Setter Property="Padding" Value="0" />
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                    Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <Border Padding="9,8" Cursor="Hand" PreviewMouseLeftButtonDown="OnBoneHeaderMouseLeftButtonDown">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource HoverBackground}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                        <Setter Property="Background" Value="#202B34" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <TextBlock Text="{Binding BoneName}" Foreground="{StaticResource PrimaryText}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource SecondaryText}" StrokeThickness="1.2"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                                <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" CenterX="4" CenterY="2" /></Setter.Value></Setter>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Margin="9,0,9,10"
                                                                Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <controls:BoneTransformControl HorizontalAlignment="Stretch" />
                                                        <Grid Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="5" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="5" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid>
                                                                <TextBox DataContext="{Binding X}" Padding="18,3,4,3" FontSize="10"
                                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G6}}"
                                                                         PreviewKeyDown="OnNumericValueKeyDown" GotKeyboardFocus="OnNumericValueGotFocus"
                                                                         LostKeyboardFocus="OnNumericValueLostFocus" PreviewMouseWheel="OnNumericValueMouseWheel" />
                                                                <TextBlock Text="X" Foreground="{StaticResource Accent}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                            </Grid>
                                                            <Grid Grid.Column="2">
                                                                <TextBox DataContext="{Binding Y}" Padding="18,3,4,3" FontSize="10"
                                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G6}}"
                                                                         PreviewKeyDown="OnNumericValueKeyDown" GotKeyboardFocus="OnNumericValueGotFocus"
                                                                         LostKeyboardFocus="OnNumericValueLostFocus" PreviewMouseWheel="OnNumericValueMouseWheel" />
                                                                <TextBlock Text="Y" Foreground="{StaticResource Accent}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                            </Grid>
                                                            <Grid Grid.Column="4">
                                                                <TextBox DataContext="{Binding Z}" Padding="18,3,4,3" FontSize="10"
                                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:G6}}"
                                                                         PreviewKeyDown="OnNumericValueKeyDown" GotKeyboardFocus="OnNumericValueGotFocus"
                                                                         LostKeyboardFocus="OnNumericValueLostFocus" PreviewMouseWheel="OnNumericValueMouseWheel" />
                                                                <TextBlock Text="Z" Foreground="{StaticResource Accent}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                            </Grid>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#151A20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="Texture Databases…" Command="{Binding TextureRegistrySettingsCommand}" Padding="8,2" FontSize="10" VerticalAlignment="Center" ToolTip="Manage the game-wide Texture2D registries" />
            </Grid>
        </Border>
    </Grid>
</Window>
