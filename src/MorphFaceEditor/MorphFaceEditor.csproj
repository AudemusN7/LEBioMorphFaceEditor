<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MorphFaceEditor</AssemblyName>
    <RootNamespace>MorphFaceEditor</RootNamespace>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Temporary palette tooling is absent from Release assemblies and resources. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Page Remove="Views\ThemeDebugWindow.xaml" />
    <Compile Remove="Views\ThemeDebugWindow.xaml.cs" />
    <Compile Remove="Infrastructure\DebugThemePalette.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dictionaries are embedded once by the shared localisation library. -->
    <Page Remove="Localisation\Strings.*.xaml" />
    <Resource Include="..\..\icon.ico" Link="icon.ico" />
    <Resource Include="..\..\ico_256.png" Link="ico_256.png" />
    <EmbeddedResource Include="Assets\MorphTargets\*.mft.br"
                      LogicalName="MorphFaceEditor.Assets.MorphTargets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Randomisation\*.mfr.br"
                      LogicalName="MorphFaceEditor.Assets.Randomisation.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MorphFaceEditor.Tests" />
    <InternalsVisibleTo Include="MorphFaceEditor.QA" />
    <ProjectReference Include="..\MorphFaceEditor.Core\MorphFaceEditor.Core.csproj" />
    <ProjectReference Include="..\MorphFaceEditor.Localisation\MorphFaceEditor.Localisation.csproj" />
    <ProjectReference Include="..\MorphFaceEditor.LegendaryExplorer\MorphFaceEditor.LegendaryExplorer.csproj" />
    <ProjectReference Include="..\MorphFaceEditor.Rendering\MorphFaceEditor.Rendering.csproj" />
  </ItemGroup>
</Project>
