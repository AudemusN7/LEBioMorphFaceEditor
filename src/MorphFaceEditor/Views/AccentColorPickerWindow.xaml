<Window x:Class="MorphFaceEditor.Views.AccentColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MorphFaceEditor.Controls"
        Title="{DynamicResource loc_Settings_AccentColour}" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}">
    <StackPanel Margin="22">
        <controls:ColorWheelControl x:Name="Wheel" Width="260" Height="260" HueOnly="True" Focusable="True"
                                   ColourChanged="OnHueChanged" AutomationProperties.Name="{DynamicResource loc_View_AccentColorPickerWindow_AccentHue}" />
        <Border Height="30" Margin="0,16,0,12" Background="{DynamicResource Accent}"
                BorderBrush="{DynamicResource SwatchBorder}" BorderThickness="1" CornerRadius="3" />
        <TextBlock Text="{DynamicResource loc_View_AccentColorPickerWindow_ChooseAHue}" Foreground="{DynamicResource SecondaryText}" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource WarningText}" Margin="0,6,0,0" />
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="ResetButton" Content="{DynamicResource loc_View_AccentColorPickerWindow_Reset}" Click="OnReset" HorizontalAlignment="Left" Padding="10,6" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource loc_Common_Cancel}" IsCancel="True" Margin="0,0,6,0" Padding="10,6" />
                <Button x:Name="ApplyButton" Content="{DynamicResource loc_View_AccentColorPickerWindow_Apply}" IsDefault="True" Click="OnApply" Padding="10,6" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
