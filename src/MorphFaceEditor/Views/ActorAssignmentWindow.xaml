<Window x:Class="MorphFaceEditor.Views.ActorAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1050" Height="720" MinWidth="850" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Introduction}" TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryText}" Margin="0,0,0,12" />
        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8,6" Margin="0,0,0,12"
                 ToolTip="Search tags, actor/type/archetype names, classes, UIndexes, and paths"
                 AutomationProperties.Name="Search actor assignment candidates" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBackground}" CornerRadius="5" Padding="8">
                <ListBox ItemsSource="{Binding FilteredChoices}" SelectedItem="{Binding SelectedChoice}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}"
                                               Margin="5,12,5,5" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,6" Width="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=ActualWidth}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                <Border Grid.Column="1" Background="#2A3C5069" CornerRadius="3" Padding="5,2" Margin="8,0,18,0">
                                    <TextBlock Text="{Binding EligibilityLabel}" FontSize="9" FontWeight="Bold" />
                                </Border>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TechnicalIdentity}"
                                           Foreground="{StaticResource SecondaryText}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,18,0" />
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding EvidenceSummary}"
                                           Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,18,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" CornerRadius="5" Padding="12">
                <TextBox Text="{Binding SelectedChoice.Details}" IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                         Background="Transparent" Foreground="{StaticResource SecondaryText}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button Content="{Binding ConfirmLabel}" IsDefault="True" MinWidth="126"
                    IsEnabled="{Binding CanConfirm}" Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
