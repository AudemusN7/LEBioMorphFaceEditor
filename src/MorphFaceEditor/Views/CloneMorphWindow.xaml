<Window x:Class="MorphFaceEditor.Views.CloneMorphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource loc_View_CloneMorphWindow_CloneBioMorphFace}"
        Width="500" Height="220" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="IntroText" Text="{DynamicResource loc_View_CloneMorphWindow_CreateAnIndependentFaceAndMaterialOverrideChildBesideTh}"
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,14" />
        <TextBlock Grid.Row="1" Text="{DynamicResource loc_View_CloneMorphWindow_NEWBIOMORPHFACENAME}" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="ObjectNameBox" Grid.Row="2" Margin="0,5,0,0" />
        <TextBlock x:Name="ValidationText" Grid.Row="3" Foreground="{DynamicResource ValidationForeground}" FontSize="11"
                   Margin="0,6,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource loc_Common_Cancel}" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button x:Name="PrimaryButton" Content="{DynamicResource loc_View_MainWindow_CloneMorph}" IsDefault="True" MinWidth="112" Click="OnClone" />
        </StackPanel>
    </Grid>
</Window>
