<Window x:Class="MorphFaceEditor.Views.ConvertMorphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert Morph"
        Width="650" Height="315" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Convert slider values, final-skeleton residuals, and compatible material overrides onto a destination-game face template. Choose an existing PCC containing a matching face, or leave it blank to create a new minimal PCC from a template you select."
                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,15" />
        <StackPanel Grid.Row="1" Margin="0,0,0,13">
            <TextBlock Text="TARGET GAME" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TargetGameBox" Width="150" HorizontalAlignment="Left" Margin="0,5,0,0"
                      DisplayMemberPath="Label" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="EXISTING DESTINATION PCC (OPTIONAL)" Style="{StaticResource FieldLabel}" />
            <Grid Grid.Row="1" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationBox" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Browse Existing…" Margin="8,0,0,0" Click="OnBrowse" />
            </Grid>
        </Grid>
        <TextBlock x:Name="ValidationText" Grid.Row="3" Foreground="#FFFF8C8C" FontSize="11"
                   Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button Content="Convert Morph" IsDefault="True" MinWidth="120" Click="OnConvert" />
        </StackPanel>
    </Grid>
</Window>
