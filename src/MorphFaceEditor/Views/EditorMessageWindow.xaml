<Window x:Class="MorphFaceEditor.Views.EditorMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" MinHeight="210" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Foreground="{DynamicResource Accent}" FontSize="12"
                   FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,13,0,22"
                   Foreground="{DynamicResource SecondaryText}" FontSize="13"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="{DynamicResource loc_View_EditorMessageWindow_Cancel}" MinWidth="84" Margin="0,0,8,0"
                    Visibility="Collapsed" IsCancel="True" Click="OnCancel" />
            <Button x:Name="SecondaryButton" Content="{DynamicResource loc_View_EditorMessageWindow_No}" MinWidth="84" Margin="0,0,8,0"
                    IsCancel="True" Click="OnSecondary" />
            <Button x:Name="PrimaryButton" Content="{DynamicResource loc_View_EditorMessageWindow_OK}" MinWidth="84"
                    IsDefault="True" Click="OnPrimary" />
        </StackPanel>
    </Grid>
</Window>
