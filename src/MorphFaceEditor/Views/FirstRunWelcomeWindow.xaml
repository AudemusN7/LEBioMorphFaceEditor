<Window x:Class="MorphFaceEditor.Views.FirstRunWelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to BioMorphFace Editor"
        Icon="pack://application:,,,/MorphFaceEditor;component/icon.ico"
        Width="650"
        MinHeight="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="30,30,30,28">
            <Grid x:Name="WelcomeHeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="ProgramIconImage"
                       Source="pack://application:,,,/MorphFaceEditor;component/ico_256.png"
                       Width="64" Height="64"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stretch="Uniform" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Welcome to BioMorphFace Editor"
                               FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,0,0,0"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="13" TextWrapping="Wrap"
                               Text="Inspect, edit, convert and export Mass Effect Legendary Edition BioMorphFace and head data with a live mesh/material editor." />
                </StackPanel>
            </Grid>

            <TextBlock Margin="80,18,0,22" FontSize="14">
                <Hyperlink NavigateUri="https://github.com/AudemusN7/LEBioMorphFaceEditor"
                           Foreground="{StaticResource Accent}"
                           RequestNavigate="OnTutorialNavigate">Read the GitHub tutorial</Hyperlink>
            </TextBlock>

            <Border Background="{StaticResource RaisedBackground}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RECOMMENDED: BUILD YOUR TEXTURE DATABASES"
                               Foreground="{StaticResource Accent}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,0"
                               Foreground="{StaticResource SecondaryText}"
                               FontSize="13" TextWrapping="Wrap"
                               Text="Mesh/Texture Databases let the editor find and use textures, attachment meshes, and compatible templates outside of the currently opened package" />
                    <TextBlock x:Name="DatabaseConsequenceText" Grid.Row="2" Margin="0,9,0,0"
                               Foreground="{StaticResource MutedText}"
                               FontSize="12" TextWrapping="Wrap"
                               Text="Without one, you can still open and edit faces, but installed game texture choices and automatic template discovery will be unavailable. Some conversion, import and export workflows need to index game assets, and will require you to build the relevant database first." />
                </Grid>
            </Border>

            <Button Margin="0,14,0,0" HorizontalAlignment="Right"
                    Content="Build Mesh/Texture Databases" MinWidth="220"
                    Click="OnBuildTextureDatabases" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="DontShowAgainCheckBox"
                          Content="Don’t show this again"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Not Now" MinWidth="86" Margin="0,0,8,0"
                            Click="OnDismiss" />
                    <Button Content="Continue to Editor" MinWidth="136"
                            IsDefault="True" Click="OnDismiss" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
