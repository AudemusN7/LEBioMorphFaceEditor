<Window x:Class="MorphFaceEditor.Views.FirstRunWelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource loc_View_FirstRunWelcomeWindow_WelcomeToBioMorphFaceEditor}"
        Icon="pack://application:,,,/MorphFaceEditor;component/icon.ico"
        Width="650"
        MinHeight="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="30,30,30,28">
            <Grid x:Name="WelcomeHeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="ProgramIconImage"
                       Source="pack://application:,,,/MorphFaceEditor;component/ico_256.png"
                       Width="64" Height="64"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stretch="Uniform" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource loc_View_FirstRunWelcomeWindow_WelcomeToBioMorphFaceEditor}"
                               FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,0,0,0"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="13" TextWrapping="Wrap"
                               Text="{DynamicResource loc_View_FirstRunWelcomeWindow_InspectEditConvertAndExportMassEffectLegendaryEditionBi}" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="80,18,0,22" FontSize="14">
                <Hyperlink NavigateUri="https://github.com/AudemusN7/LEBioMorphFaceEditor"
                           Foreground="{DynamicResource Accent}"
                           RequestNavigate="OnTutorialNavigate"><Run Text="{DynamicResource loc_View_FirstRunWelcomeWindow_ReadTheGitHubTutorial}" /></Hyperlink>
            </TextBlock>

            <Border Background="{DynamicResource RaisedBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource loc_View_FirstRunWelcomeWindow_RECOMMENDEDBUILDYOURTEXTUREDATABASES}"
                               Foreground="{DynamicResource Accent}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="13" TextWrapping="Wrap"
                               Text="{DynamicResource loc_View_FirstRunWelcomeWindow_MeshTextureDatabasesLetTheEditorFindAndUseTexturesAttac}" />
                    <TextBlock x:Name="DatabaseConsequenceText" Grid.Row="2" Margin="0,9,0,0"
                               Foreground="{DynamicResource MutedText}"
                               FontSize="12" TextWrapping="Wrap"
                               Text="{DynamicResource loc_View_FirstRunWelcomeWindow_WithoutOneYouCanStillOpenAndEditFacesButInstalledGameTe}" />
                </Grid>
            </Border>

            <Button Margin="0,14,0,0" HorizontalAlignment="Right"
                    Content="{DynamicResource loc_View_FirstRunWelcomeWindow_BuildMeshTextureDatabases}" MinWidth="220"
                    Click="OnBuildTextureDatabases" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="DontShowAgainCheckBox"
                          Content="{DynamicResource loc_View_FirstRunWelcomeWindow_DonTShowThisAgain}"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource loc_View_FirstRunWelcomeWindow_NotNow}" MinWidth="86" Margin="0,0,8,0"
                            Click="OnDismiss" />
                    <Button Content="{DynamicResource loc_View_FirstRunWelcomeWindow_ContinueToEditor}" MinWidth="136"
                            IsDefault="True" Click="OnDismiss" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
