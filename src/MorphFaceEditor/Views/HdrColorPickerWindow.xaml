<Window x:Class="MorphFaceEditor.Views.HdrColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MorphFaceEditor.Controls"
        Title="{DynamicResource loc_View_HdrColorPickerWindow_HDRColour}" Width="650" Height="740" MinWidth="610" MinHeight="700" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="260" />
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:ColorWheelControl x:Name="Wheel" Width="245" Height="245"
                                        ColourChanged="OnWheelChanged" />
            <Grid x:Name="HdrIntensityPanel" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Slider x:Name="IntensitySlider" Orientation="Vertical" Minimum="1" Maximum="8"
                        HorizontalAlignment="Center" Width="24"
                        ValueChanged="OnWheelChanged" Margin="0,8,0,2"
                        ToolTip="{DynamicResource loc_View_HdrColorPickerWindow_HDRIntensityMultiplier18}"
                        AutomationProperties.Name="{DynamicResource loc_View_HdrColorPickerWindow_HDRIntensity}" />
                <TextBlock x:Name="HdrIntensityLabel" Grid.Row="1"
                           Text="{Binding ElementName=IntensitySlider, Path=Value, StringFormat={StaticResource loc_View_HdrColorPickerWindow_HdrIntensityFormat}}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}" FontSize="10" />
            </Grid>
            <Border x:Name="PreviewSwatch" Grid.Column="2" Margin="16,8,0,8" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource loc_View_HdrColorPickerWindow_LIVEPREVIEW}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="PreviewCaption" Text="{DynamicResource loc_View_HdrColorPickerWindow_HDRValuesArePreserved}" Foreground="{DynamicResource OnColourText}" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource loc_View_HdrColorPickerWindow_BRIGHTNESS}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
            <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="1"
                    VerticalAlignment="Center" ValueChanged="OnWheelChanged" />
            <TextBlock Grid.Column="2" Text="{Binding ElementName=BrightnessSlider, Path=Value, StringFormat={}{0:F3}}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,4,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" /><RowDefinition Height="42" />
                <RowDefinition Height="42" /><RowDefinition x:Name="AlphaRow" Height="42" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource loc_View_HdrColorPickerWindow_R}" VerticalAlignment="Center" Foreground="#FF786F" />
            <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="1"
                    VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBox Grid.Column="2" Text="{Binding ElementName=RedSlider, Path=Value, StringFormat={}{0:F4}, UpdateSourceTrigger=PropertyChanged}" Margin="8,7,0,7" />
            <TextBlock Grid.Row="1" Text="{DynamicResource loc_View_HdrColorPickerWindow_G}" VerticalAlignment="Center" Foreground="#65D98B" />
            <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1"
                    VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=GreenSlider, Path=Value, StringFormat={}{0:F4}, UpdateSourceTrigger=PropertyChanged}" Margin="8,7,0,7" />
            <TextBlock Grid.Row="2" Text="{DynamicResource loc_View_HdrColorPickerWindow_B}" VerticalAlignment="Center" Foreground="#68A8FF" />
            <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1"
                    VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding ElementName=BlueSlider, Path=Value, StringFormat={}{0:F4}, UpdateSourceTrigger=PropertyChanged}" Margin="8,7,0,7" />
            <TextBlock Grid.Row="3" Text="{DynamicResource loc_View_HdrColorPickerWindow_A}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" />
            <Slider x:Name="AlphaSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1"
                    VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding ElementName=AlphaSlider, Path=Value, StringFormat={}{0:F4}, UpdateSourceTrigger=PropertyChanged}" Margin="8,7,0,7" />
            <TextBlock Grid.Row="4" Text="{DynamicResource loc_View_HdrColorPickerWindow_HEX}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
            <TextBox x:Name="HexTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,7"
                     Padding="6,3" PreviewKeyDown="OnHexKeyDown" LostKeyboardFocus="OnHexLostFocus"
                     ToolTip="{DynamicResource loc_View_HdrColorPickerWindow_RRGGBBOrRRGGBBAAHDRComponentsAreClippedToTheDisplayable}" />
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ResetBackgroundButton" Content="{DynamicResource loc_View_HdrColorPickerWindow_UseThemeDefault}" MinWidth="132"
                    Margin="0,0,16,0" Click="OnResetBackground" Visibility="Collapsed" />
            <Button Content="{DynamicResource loc_View_HdrColorPickerWindow_Cancel}" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button Content="{DynamicResource loc_View_HdrColorPickerWindow_Apply}" IsDefault="True" MinWidth="84" Click="OnApply" />
        </StackPanel>
    </Grid>
</Window>
