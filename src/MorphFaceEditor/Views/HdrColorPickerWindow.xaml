<Window x:Class="MorphFaceEditor.Views.HdrColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MorphFaceEditor.Controls"
        Title="HDR colour" Width="650" Height="690" MinWidth="610" MinHeight="650" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="260" />
            <RowDefinition x:Name="IntensityRow" Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:ColorWheelControl x:Name="Wheel" Width="245" Height="245" ColourChanged="OnWheelChanged" />
            <Slider x:Name="ValueSlider" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="1"
                    ValueChanged="OnWheelChanged" Margin="5,8" />
            <Border x:Name="PreviewSwatch" Grid.Column="2" Margin="16,8,0,8" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="PreviewCaption" Text="HDR values are preserved" Foreground="#DDFFFFFF" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="HDR INTENSITY" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
            <Slider x:Name="IntensitySlider" Grid.Column="1" Minimum="1" Maximum="8"
                    VerticalAlignment="Center" ValueChanged="OnWheelChanged" />
            <TextBlock Grid.Column="2" Text="{Binding ElementName=IntensitySlider, Path=Value, StringFormat={}{0:F3}×}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,4,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" /><RowDefinition Height="42" />
                <RowDefinition Height="42" /><RowDefinition x:Name="AlphaRow" Height="42" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <TextBlock Text="R" VerticalAlignment="Center" Foreground="#FF786F" />
            <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="8"
                    VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBox Grid.Column="2" Text="{Binding ElementName=RedSlider, Path=Value, StringFormat={}{0:F4}, UpdateSourceTrigger=PropertyChanged}" Margin="8,7,0,7" />
            <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" Foreground="#65D98B" />
            <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="8"
                    VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=GreenSlider, Path=Value, StringFormat={}{0:F4}, UpdateSourceTrigger=PropertyChanged}" Margin="8,7,0,7" />
            <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" Foreground="#68A8FF" />
            <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="8"
                    VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding ElementName=BlueSlider, Path=Value, StringFormat={}{0:F4}, UpdateSourceTrigger=PropertyChanged}" Margin="8,7,0,7" />
            <TextBlock Grid.Row="3" Text="A" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" />
            <Slider x:Name="AlphaSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="8"
                    VerticalAlignment="Center" ValueChanged="OnRgbChanged" />
            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding ElementName=AlphaSlider, Path=Value, StringFormat={}{0:F4}, UpdateSourceTrigger=PropertyChanged}" Margin="8,7,0,7" />
            <TextBlock Grid.Row="4" Text="HEX" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
            <TextBox x:Name="HexTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,7"
                     Padding="6,3" PreviewKeyDown="OnHexKeyDown" LostKeyboardFocus="OnHexLostFocus"
                     ToolTip="#RRGGBB or #RRGGBBAA. HDR components are clipped to the displayable HEX range." />
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button Content="Apply" IsDefault="True" MinWidth="84" Click="OnApply" />
        </StackPanel>
    </Grid>
</Window>
