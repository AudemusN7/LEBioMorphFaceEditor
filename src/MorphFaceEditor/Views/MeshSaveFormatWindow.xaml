<Window x:Class="MorphFaceEditor.Views.MeshSaveFormatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource loc_View_MainWindow_SavePackage}" Width="510" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}">
    <StackPanel Margin="22">
        <TextBlock Text="{DynamicResource loc_FileSave_MeshChoice}" TextWrapping="Wrap" Margin="0,0,0,18" />
        <Button Content="{DynamicResource loc_View_MainWindow_ExportToPCC}" Click="OnPcc" Margin="0,0,0,8" />
        <Button Content="{DynamicResource loc_FileSave_ExportMaterialRon}" Click="OnMaterials" Margin="0,0,0,18" />
        <Button Content="{DynamicResource loc_View_UnsavedChangesWindow_Cancel}" IsCancel="True" HorizontalAlignment="Right" MinWidth="82" />
    </StackPanel>
</Window>
