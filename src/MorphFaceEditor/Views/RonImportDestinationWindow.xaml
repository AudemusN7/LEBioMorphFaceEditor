<Window x:Class="MorphFaceEditor.Views.RonImportDestinationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource loc_View_RonImportDestinationWindow_ChooseRONDestination}"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource loc_View_RonImportDestinationWindow_ChooseHowToImportThisRONTheTargetGameAndNPCArchetypeDet}"
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" />

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="{DynamicResource loc_View_ConvertMorphWindow_TARGETGAME}" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="TargetGameText" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{DynamicResource loc_View_RonImportDestinationWindow_NPCARCHETYPE}" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="ArchetypeText" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="ValidationText" Grid.Row="3" Margin="0,10,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource ValidationForeground}" FontSize="11" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource loc_Common_Cancel}" IsCancel="True" MinWidth="76" Margin="0,0,8,0" />
            <Button x:Name="NpcButton" Content="{DynamicResource loc_View_RonImportDestinationWindow_NPCMorph}" MinWidth="105" Margin="0,0,8,0" Click="OnNpcMorph" />
            <Button x:Name="PlayerButton" Content="{DynamicResource loc_View_RonImportDestinationWindow_PlayerMorph}" MinWidth="105" Click="OnPlayerMorph" />
        </StackPanel>
    </Grid>
</Window>
