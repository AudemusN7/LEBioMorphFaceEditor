<Window x:Class="MorphFaceEditor.Views.RonImportDestinationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose RON destination"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Choose how to import this RON. The target game and NPC archetype determine the native assets used to build the workspace."
                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" />

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="TARGET GAME" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="TargetGameText" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="NPC ARCHETYPE" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="ArchetypeText" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="ValidationText" Grid.Row="3" Margin="0,10,0,0"
                   TextWrapping="Wrap" Foreground="#FFFF8C8C" FontSize="11" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="76" Margin="0,0,8,0" />
            <Button x:Name="NpcButton" Content="NPC Morph" MinWidth="105" Margin="0,0,8,0" Click="OnNpcMorph" />
            <Button x:Name="PlayerButton" Content="Player Morph" MinWidth="105" Click="OnPlayerMorph" />
        </StackPanel>
    </Grid>
</Window>
