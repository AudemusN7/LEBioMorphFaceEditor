<Window x:Class="MorphFaceEditor.Views.SaveMorphToPccWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource loc_View_SaveNewInstanceWindow_SaveToPCC}"
        Width="620" Height="245" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource loc_View_SaveNewInstanceWindow_ExportTheSelectedMorphAndItsRequiredAssetsWhilePreservi}"
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,16" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource loc_View_ConvertMorphWindow_EXISTINGDESTINATIONPCCOPTIONAL}" Style="{StaticResource FieldLabel}" />
            <Grid Grid.Row="1" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationBox" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="{DynamicResource loc_View_SaveNewInstanceWindow_BrowseExisting}" Margin="8,0,0,0" Click="OnBrowse" />
            </Grid>
        </Grid>
        <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="{DynamicResource ValidationForeground}" FontSize="11"
                   Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource loc_Common_Cancel}" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button Content="{DynamicResource loc_View_SaveNewInstanceWindow_Save}" IsDefault="True" MinWidth="112" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
