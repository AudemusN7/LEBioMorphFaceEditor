<Window x:Class="MorphFaceEditor.Views.SaveMorphToPccWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Morph to PCC"
        Width="620" Height="245" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Export the selected morph and its required assets while preserving its instanced path. Choose an existing PCC to add it there, or leave this field blank to create a new minimal PCC."
                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,16" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="EXISTING DESTINATION PCC (OPTIONAL)" Style="{StaticResource FieldLabel}" />
            <Grid Grid.Row="1" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationBox" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="Browse Existing…" Margin="8,0,0,0" Click="OnBrowse" />
            </Grid>
        </Grid>
        <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="#FFFF8C8C" FontSize="11"
                   Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button Content="Save Morph" IsDefault="True" MinWidth="112" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
