<Window x:Class="MorphFaceEditor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource loc_Settings_Title}" Width="660" Height="760" MinWidth="580" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}">
    <Window.Resources>
        <Style x:Key="SettingsSection" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SettingsDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,12" />
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource loc_Settings_Heading}" Foreground="{DynamicResource Accent}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsSections">
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource loc_Settings_Language}" Style="{StaticResource SettingsHeading}" />
                        <TextBlock Text="{DynamicResource loc_Settings_LanguageDescription}" Style="{StaticResource SettingsDescription}" />
                        <ComboBox x:Name="LanguageSelector" SelectionChanged="OnLanguageSelectionChanged" AutomationProperties.Name="{DynamicResource loc_Settings_Language}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Image Source="{Binding Flag}" Width="30" Height="20" Stretch="Fill" />
                                        </Border>
                                        <TextBlock Text="{Binding NativeName}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource loc_Settings_Theme}" Style="{StaticResource SettingsHeading}" />
                        <ComboBox x:Name="ThemeSelector" Margin="0,12,0,0" SelectionChanged="OnThemeSelectionChanged" AutomationProperties.Name="{DynamicResource loc_Settings_Theme}">
                            <ComboBoxItem Content="{DynamicResource loc_Settings_ThemeSystem}" />
                            <ComboBoxItem Content="{DynamicResource loc_Settings_ThemeLight}" />
                            <ComboBoxItem Content="{DynamicResource loc_Settings_ThemeDark}" />
                        </ComboBox>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource loc_Settings_AccentColour}" VerticalAlignment="Center" />
                            <Button x:Name="AccentColourButton" Grid.Column="1" Click="OnAccentColourClick" Margin="12,0,0,0"
                                    Padding="4" AutomationProperties.Name="{DynamicResource loc_Settings_AccentColour}" ToolTip="{DynamicResource loc_Settings_AccentTooltip}">
                                <Border Width="56" Height="24" Background="{DynamicResource Accent}"
                                        BorderBrush="{DynamicResource SwatchBorder}" BorderThickness="1" CornerRadius="2" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource loc_Settings_GenerateLogs}" Style="{StaticResource SettingsHeading}" />
                        <TextBlock Text="{DynamicResource loc_Settings_GenerateLogsDescription}" Style="{StaticResource SettingsDescription}" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="GenerateLogsButton" Content="{DynamicResource loc_Settings_GenerateLogsButton}" Click="OnGenerateLogsClick" />
                            <Button x:Name="OpenLogButton" Content="{DynamicResource loc_Settings_OpenLogButton}" Click="OnOpenLogClick" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSection}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource loc_Settings_ClearData}" Style="{StaticResource SettingsHeading}" />
                        <TextBlock Text="{DynamicResource loc_Settings_ClearDataDescription}" Style="{StaticResource SettingsDescription}" />
                        <Button x:Name="ClearDataButton" Content="{DynamicResource loc_Settings_ClearDataButton}" Click="OnClearDataClick" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="OperationStatus" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Button x:Name="CloseButton" Grid.Column="1" Content="{DynamicResource loc_Settings_Close}" IsCancel="True" Click="OnCloseClick" MinWidth="85" />
        </Grid>
    </Grid>
</Window>
