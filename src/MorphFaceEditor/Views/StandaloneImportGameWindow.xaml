<Window x:Class="MorphFaceEditor.Views.StandaloneImportGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource loc_View_StandaloneImportGameWindow_ImportMorph}"
        Width="420" Height="220" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Text="{DynamicResource loc_View_StandaloneImportGameWindow_ChooseTheLegendaryEditionGameToUseForThisImport}"
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,16" />
        <StackPanel Grid.Row="1">
            <TextBlock Text="{DynamicResource loc_View_StandaloneImportGameWindow_TARGETGAME}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="GameBox" Width="150" HorizontalAlignment="Left" Margin="0,5,0,0"
                      DisplayMemberPath="Label" />
            <StackPanel x:Name="SexPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource loc_View_StandaloneImportGameWindow_PLAYER}" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="SexBox" Width="150" HorizontalAlignment="Left" Margin="0,5,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource loc_View_StandaloneImportGameWindow_Male}" />
                    <ComboBoxItem Content="{DynamicResource loc_View_StandaloneImportGameWindow_Female}" />
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="{DynamicResource ValidationForeground}" FontSize="11"
                   Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource loc_View_StandaloneImportGameWindow_Cancel}" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button x:Name="ContinueButton" Content="{DynamicResource loc_View_StandaloneImportGameWindow_ChooseImportFile}" IsDefault="True" MinWidth="132" Click="OnContinue" />
        </StackPanel>
    </Grid>
</Window>
