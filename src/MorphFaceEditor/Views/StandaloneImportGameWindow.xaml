<Window x:Class="MorphFaceEditor.Views.StandaloneImportGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MorphFaceEditor.Controls"
        xmlns:domain="clr-namespace:MorphFaceEditor.Core.Domain;assembly=MorphFaceEditor.Core"
        Title="{DynamicResource loc_View_StandaloneImportGameWindow_ImportMorph}"
        Width="420" Height="220" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
    <Window.Resources>
        <Style x:Key="ImportGameButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="66" />
            <Setter Property="Height" Value="66" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryText}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Text="{DynamicResource loc_View_StandaloneImportGameWindow_ChooseTheLegendaryEditionGameToUseForThisImport}"
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,16" />
        <StackPanel x:Name="ImportGamePanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource ImportGameButton}" Tag="{x:Static domain:MorphFaceGame.LE1}" Click="OnImportGame" Margin="0,0,26,0">
                <Button.Background>
                    <ImageBrush ImageSource="pack://application:,,,/MorphFaceEditor;component/Assets/GameIcons/LE1.png" />
                </Button.Background>
            </Button>
            <Button Style="{StaticResource ImportGameButton}" Tag="{x:Static domain:MorphFaceGame.LE2}" Click="OnImportGame" Margin="0,0,26,0">
                <Button.Background>
                    <ImageBrush ImageSource="pack://application:,,,/MorphFaceEditor;component/Assets/GameIcons/LE2.png" />
                </Button.Background>
            </Button>
            <Button Style="{StaticResource ImportGameButton}" Tag="{x:Static domain:MorphFaceGame.LE3}" Click="OnImportGame">
                <Button.Background>
                    <ImageBrush ImageSource="pack://application:,,,/MorphFaceEditor;component/Assets/GameIcons/LE3.png" />
                </Button.Background>
            </Button>
        </StackPanel>
        <StackPanel x:Name="NewPlayerPanel" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource loc_View_ConvertMorphWindow_TARGETGAME}" Style="{StaticResource FieldLabel}" />
            <controls:GameSelector x:Name="TargetGameSelector" Margin="0,8,0,0"
                                   AutomationProperties.Name="{DynamicResource loc_View_ConvertMorphWindow_TARGETGAME}" />
            <StackPanel x:Name="SexPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource loc_View_StandaloneImportGameWindow_PLAYER}" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="SexBox" Width="150" HorizontalAlignment="Left" Margin="0,5,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="{DynamicResource loc_View_StandaloneImportGameWindow_Male}" />
                    <ComboBoxItem Content="{DynamicResource loc_View_StandaloneImportGameWindow_Female}" />
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="2" Visibility="Collapsed" Foreground="{DynamicResource ValidationForeground}" FontSize="11"
                   Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="{DynamicResource loc_Common_Cancel}" IsCancel="True" MinWidth="84" />
            <Button x:Name="ContinueButton" Content="{DynamicResource loc_View_StandaloneImportGameWindow_ChooseImportFile}" Visibility="Collapsed" MinWidth="132" Click="OnContinue" />
        </StackPanel>
    </Grid>
</Window>
