<Window x:Class="MorphFaceEditor.Views.StandaloneImportGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Morph"
        Width="420" Height="220" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Choose the Legendary Edition game this RON or mesh was made for."
                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,16" />
        <StackPanel Grid.Row="1">
            <TextBlock Text="TARGET GAME" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="GameBox" Width="150" HorizontalAlignment="Left" Margin="0,5,0,0"
                      DisplayMemberPath="Label" />
        </StackPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="2" Foreground="#FFFF8C8C" FontSize="11"
                   Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
            <Button Content="Choose Import File" IsDefault="True" MinWidth="132" Click="OnContinue" />
        </StackPanel>
    </Grid>
</Window>
