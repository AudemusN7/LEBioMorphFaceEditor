<Window x:Class="MorphFaceEditor.Views.TextureRegistrySettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource loc_View_TextureRegistrySettingsWindow_MeshTextureDatabases}" Width="660" Height="560" MinHeight="500" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource loc_View_TextureRegistrySettingsWindow_INSTALLEDMESHTEXTUREDATABASES}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource loc_View_TextureRegistrySettingsWindow_ScanEachInstalledGameForRelevantHeadTexturesAndAttachme}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,12,10"/></StackPanel><Button Grid.Column="1" Content="{Binding RebuildAllActionLabel}" Click="OnRebuildAllClick" VerticalAlignment="Top" Padding="10,3" Visibility="{Binding IsRebuildAllActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/><StackPanel Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding IsBuilding, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,14"><ProgressBar Height="8" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/><TextBlock Text="{Binding ProgressLabel}" Foreground="{DynamicResource SecondaryText}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Grid>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding GameLabel}" FontSize="15" FontWeight="SemiBold"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,7,0">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource StatusFailed}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusBrushKey}" Value="StatusReady"><Setter Property="Fill" Value="{DynamicResource StatusReady}" /></DataTrigger>
                            <DataTrigger Binding="{Binding StatusBrushKey}" Value="StatusPending"><Setter Property="Fill" Value="{DynamicResource StatusPending}" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"/>
                  </StackPanel>
                  <TextBlock Text="{Binding LastBuiltLabel, StringFormat={StaticResource loc_View_TextureRegistrySettingsWindow_LastBuiltFormat}}"
                             Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding ManualStatusLabel}" Foreground="{DynamicResource SecondaryText}"
                             FontSize="10" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding WarningLabel}" Foreground="{DynamicResource WarningText}"
                             FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="{DynamicResource loc_View_TextureRegistrySettingsWindow_AddCustomAsset}" Click="OnAddCustomAssetClick" Padding="10,3"
                          Margin="0,0,8,0" IsEnabled="{Binding CanAddCustomAsset}"
                          Visibility="{Binding IsAddCustomAssetVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <Button Content="{Binding DataContext.ActionLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                          Click="OnRebuildClick" Padding="10,3"
                          Visibility="{Binding IsBuildActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
</Window>
