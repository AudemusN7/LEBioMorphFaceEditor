<Window x:Class="MorphFaceEditor.Views.TextureRegistrySettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Mesh/Texture Databases" Width="660" Height="560" MinHeight="500" Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}" WindowStartupLocation="CenterOwner" WindowStyle="None">
  <WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
  <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><TextBlock Text="MESH/TEXTURE DATABASES" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/><Button Content="×" HorizontalAlignment="Right" Width="36" Height="36" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource SecondaryText}" Click="OnCloseClick" IsEnabled="{Binding CanClose}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/></Grid></Border>
    <Grid Grid.Row="1" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="INSTALLED MESH/TEXTURE DATABASES" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="Scan each installed game for relevant head textures and attachment meshes. Add individual assets from a PCC when you need to include something the scan did not find." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,12,10"/></StackPanel><Button Grid.Column="1" Content="{Binding RebuildAllActionLabel}" Click="OnRebuildAllClick" VerticalAlignment="Top" Padding="10,3" Visibility="{Binding IsRebuildAllActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/><StackPanel Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding IsBuilding, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,14"><ProgressBar Height="8" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/><TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource SecondaryText}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Grid>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding GameLabel}" FontSize="15" FontWeight="SemiBold"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusColour}" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold"/>
                  </StackPanel>
                  <TextBlock Text="{Binding LastBuiltLabel, StringFormat=Last Built: {0}}"
                             Foreground="{StaticResource SecondaryText}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding ManualStatusLabel}" Foreground="{StaticResource SecondaryText}"
                             FontSize="10" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding WarningLabel}" Foreground="#FFFF8C8C"
                             FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Add Custom Asset" Click="OnAddCustomAssetClick" Padding="10,3"
                          Margin="0,0,8,0" IsEnabled="{Binding CanAddCustomAsset}"
                          Visibility="{Binding IsAddCustomAssetVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <Button Content="{Binding DataContext.ActionLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                          Click="OnRebuildClick" Padding="10,3"
                          Visibility="{Binding IsBuildActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</Window>
