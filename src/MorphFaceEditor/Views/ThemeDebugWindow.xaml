<Window x:Class="MorphFaceEditor.Views.ThemeDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource loc_View_ThemeDebugWindow_ThemePaletteDebug}" Width="590" Height="740" MinWidth="480" MinHeight="400"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource loc_View_ThemeDebugWindow_LIVETHEMEPALETTE}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource loc_View_ThemeDebugWindow_ClickASwatchToEditLinkedRolesUpdateTogetherCancelRestor}"
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ColourRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PanelBackground}" Padding="10" Margin="0,0,0,6" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Group}" Foreground="{DynamicResource MutedText}" FontSize="10" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Roles}" Foreground="{DynamicResource SecondaryText}"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Click="OnEditColour" Padding="3" ToolTip="{DynamicResource loc_View_ThemeDebugWindow_EditThisSharedColour}">
                                        <Border Background="{Binding Brush}" BorderBrush="{DynamicResource SwatchBorder}"
                                                BorderThickness="1" Width="80" Height="25" />
                                    </Button>
                                    <TextBlock Text="{Binding Hex}" FontFamily="Consolas" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="SavePaletteButton" Content="{DynamicResource loc_View_ThemeDebugWindow_SaveAllColours}" Click="OnSave" HorizontalAlignment="Right" />
            <TextBlock x:Name="SaveStatus" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                       FontSize="11" Margin="0,8,0,0" />
            <TextBlock x:Name="SavePath" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" FontSize="10" />
        </StackPanel>
    </Grid>
</Window>
