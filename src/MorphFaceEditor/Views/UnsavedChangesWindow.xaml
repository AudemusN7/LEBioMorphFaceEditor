<Window x:Class="MorphFaceEditor.Views.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource loc_View_UnsavedChangesWindow_UnsavedPackageChanges}"
        Width="510" Height="230" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource loc_View_UnsavedChangesWindow_SAVECHANGES}" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,13,0,18">
            <TextBlock x:Name="SummaryText" Text="{DynamicResource loc_View_UnsavedChangesWindow_ThePackageWorkspaceHasUnsavedBioMorphFaceChanges}" FontSize="14" />
            <TextBlock x:Name="FacePathText" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SaveExplanationText" Text="{DynamicResource loc_View_UnsavedChangesWindow_SaveCommitsAllTemporaryEditsToTheSourcePCC}"
                       Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource loc_Common_Cancel}" MinWidth="82" IsCancel="True" Click="OnCancel" />
            <Button x:Name="DiscardButton" Content="{DynamicResource loc_View_UnsavedChangesWindow_DonTSave}" MinWidth="96" Margin="8,0,0,0" Click="OnDiscard" />
            <Button x:Name="SaveButton" Content="{DynamicResource loc_View_UnsavedChangesWindow_Save}" MinWidth="82" Margin="8,0,0,0" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
